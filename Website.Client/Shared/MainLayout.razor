@using BlazorBootstrap
@using DataService.Auth;
@using DataService.Interfaces.Management
@using DataService.State

@inherits LayoutComponentBase

@implements IDisposable
@inject LoginState loginState;
@inject AuthService _authService
@inject NavigationManager NavigationManager
@inject IConfiguration Configuration
@inject IUserService userService
@inject Blazored.LocalStorage.ILocalStorageService localStorage

<PageTitle>Clouseau</PageTitle>

<div class="page" style="min-width: 1500px">
    <div class="sidebar" style="max-height:100vh; min-width: 275px !important">
        <div style="max-height:95vh">
            <NavMenu />
        </div>
    </div>

    <main>
        <div class="top-row px-4" style="z-index: 999;">
            @if (_authService.IsLoggedIn)
            {
                <div>@_authService.User.UserFullName</div>
                <NavLink
                    style="color: var(--l-white); font-size: 18px; cursor: pointer; color: grey !important; margin-right: 10px; position: relative"
                         @onclick="() => expandNotificationMenu = !expandNotificationMenu">
                    <span class="oi oi-bell" style="color: var(--l-white)" aria-hidden="true"></span>
                    
                    @if (!string.IsNullOrEmpty(_authService.IncompleteHoursMessage))
                    {
                        <span style="background-color: var(--l-red); border-radius: 50px; position: absolute; height: 10px; width: 10px" aria-hidden="true"></span>
                    }
                </NavLink>
                @if (expandNotificationMenu && !string.IsNullOrEmpty(_authService.IncompleteHoursMessage))
                {
                    <ul class="dropdown-user">
                        <li class="">
                            <NavLink class="nav-link" style="cursor: pointer" @onclick="() => RedirectToRecord()">
                                <span class="oi oi-bullhorn" aria-hidden="true"></span>&nbsp;&nbsp; Tiene horas sin cargar
                            </NavLink>
                        </li>
                    </ul>
                }
                
                <NavLink
                    style="color: var(--l-white); font-size: 18px; cursor: pointer; color: grey !important;"
                    @onclick="() => expandUserMenu = !expandUserMenu">
                    <span class="oi oi-person" style="color: var(--l-white)" aria-hidden="true"></span>
                </NavLink>
                @if (expandUserMenu)
                {
                    <ul class="dropdown-user">
                        <li class="">
                            <NavLink class="nav-link" style="cursor: pointer" @onclick="() => SendRequest()">
                                <span class="oi oi-key" aria-hidden="true"></span>&nbsp;&nbsp; Cambiar Contraseña
                            </NavLink>
                        </li>
                        <BlazorBootstrap.DropdownDivider Style="color: var(--l-black); background-color: var(--l-greybluelight); margin-left: 20px" />
                        <li class="">
                            <NavLink class="nav-link" style="cursor: pointer" @onclick="() => HandleLogout()">
                                <span class="oi oi-power-standby" aria-hidden="true" style="color: red"></span>&nbsp;&nbsp; Cerrar Sesión
                            </NavLink>
                        </li>
                    </ul>
                }
            }
        </div>

        <article class="content px-4">
            <CascadingValue Value="_authService">
                @Body
            </CascadingValue>
        </article>
    </main>
</div>

<Toasts class="p-3" AutoHide="true" Delay="5000" Placement="ToastsPlacement.BottomRight" Style="z-index: 1000000" />
<Preload LoadingText="Analizando" />

@code
{
    private bool expandUserMenu;
    private bool expandNotificationMenu;
    private string Token { get; set; }

    protected override void OnInitialized()
    {
        loginState.LoginAction += StateHasChanged;
        Token = Configuration["Tokens:RecoveryToken"];
    }

    public void Dispose()
    {
        loginState.LoginAction -= StateHasChanged;
    }

    private async void SendRequest()
    {
        var result = await userService.ResetPassword(_authService.User.Username);

        if (result) NavigationManager.NavigateTo($"/newpassword/{_authService.User.Username}/{Token}");
    }

    protected async Task HandleLogout()
    {
        _authService.Logout();
        await localStorage.ClearAsync();
        loginState.InitLogin();

        NavigationManager.NavigateTo("/");
    }

    private void RedirectToRecord()
    {
        NavigationManager.NavigateTo("/users/timerecord");
    }
}