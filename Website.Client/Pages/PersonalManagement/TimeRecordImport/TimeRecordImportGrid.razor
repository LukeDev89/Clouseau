    private async Task SaveAdd()
    {
        try
        {
            string? fileExtension = null;

            if (createFile != null)
            {
                fileExtension = Path.GetExtension(createFile.Name);

                long maxSize = MAX_WEIGHT_FILE_IN_MB * 1024 * 1024;

                if (!fileExtension.ToLower().Equals(".csv"))
                {
                    ToastService.Notify(new ToastMessage()
                        {
                            Type = ToastType.Danger,
                            Message = "El archivo debe ser de tipo CSV.",
                            Title = "Error"
                        });

                    return;
                }

                if (createFile.Size == 0 || createFile.Size > maxSize)
                {
                    ToastService.Notify(new ToastMessage()
                        {
                            Type = ToastType.Danger,
                            Message = "El archivo excede el tamaño máximo permitido de 5 MB.",
                            Title = "Error"
                        });

                    return;
                }
            }
            else
            {
                ToastService.Notify(new ToastMessage()
                    {
                        Type = ToastType.Danger,
                        Message = "Debe adjuntar un archivo.",
                        Title = "Error"
                    });

                return;
            }

            using var stream = createFile.OpenReadStream();
            using var reader = new StreamReader(stream);

            var importedRecords = new List<TimeRecordCsv>();
            var taskProgressList = new List<TaskProgressRequest>();
            var errorList = new List<string>();

            string? line;
            var firstLine = true;

            while ((line = await reader.ReadLineAsync()) != null)
            {
                if (firstLine)
                {
                    firstLine = false;
                    continue;
                }

                try
                {
                    var values = line.Split(';');

                    if (string.IsNullOrEmpty(values[0]) && string.IsNullOrEmpty(values[1]))
                    {
                        break;
                    }

                    var record = new TimeRecordCsv()
                        {
                            Proyecto = values[0],
                            Fecha = DateTime.Parse(values[1]),
                            Usuario = values[2],
                            Actividad = values[3],
                            RM = values[4],
                            Peticion = values[5],
                            Comentario = values[6],
                            Horas = decimal.Parse(values[7])
                        };

                    importedRecords.Add(record);
                }
                catch (Exception ex)
                {
                    ToastService.Notify(new ToastMessage()
                        {
                            Type = ToastType.Danger,
                            Message = "Error inesperado al realizar la acción",
                            Title = "Error"
                        });
                }
            }


            var client = _clients.First(x => x.Id == _clientId);
            var project = _projects.First(x => x.Id == _projectId);

            var tasks = await _projectTaskService.GetAsync();
            var taskTypes = await _taskTypeService.GetAsync();
            var users = await _userService.GetAsync();

            foreach (var i in importedRecords)
            {
                var task = tasks.FirstOrDefault(x => x.KanbanId != null && x.KanbanId.Equals(i.RM));
                var taskType = taskTypes.FirstOrDefault(x => x.Name.Equals(i.Actividad));
                var user = users.FirstOrDefault(x => i.Usuario.Contains(x.Firstname) && i.Usuario.Contains(x.Lastname));

                if (task == null)
                {
                    await _projectTaskService.AddAsync(new ProjectTask()
                        {
                            ProjectId = project.Id,
                            Name = $"{i.RM} {i.Peticion}",
                            KanbanId = i.RM,
                            Description = $"{i.Peticion}",
                            CreationDate = importedRecords.OrderByDescending(x => x.Fecha).First().Fecha,
                        });

                    tasks = await _projectTaskService.GetAsync();
                    task = tasks.First(x => x.KanbanId != null && x.KanbanId.Equals(i.RM));
                }

                if (taskType == null)
                {
                    await _taskTypeService.AddAsync(new TaskType()
                        {
                            Name = i.Actividad
                        });

                    taskTypes = await _taskTypeService.GetAsync();
                    taskType = taskTypes.FirstOrDefault(x => x.Name.Equals(i.Actividad));
                }

                if (user == null)
                {
                    ToastService.Notify(new ToastMessage()
                        {
                            Type = ToastType.Danger,
                            Message = $"Usuario {i.Usuario} no existente en DB.",
                            Title = "Error"
                        });

                    errorList.Add($"Usuario {i.Usuario} no existente en DB.");
                    continue;
                }

                taskProgressList.Add(new TaskProgressRequest()
                    {
                        TaskId = task.Id,
                        Hours = i.Horas,
                        Date = i.Fecha,
                        UserId = user.Id,
                        TaskTypeId = taskType.Id,
                        Comment = i.Comentario
                    });

            }

            if (taskProgressList.Count == 0)
            {
                ToastService.Notify(new ToastMessage()
                    {
                        Type = ToastType.Danger,
                        Message = "No se encontraron registros válidos en el archivo.",
                        Title = "Error"
                    });

                return;
            }

            await _taskProgressService.AddAsync(taskProgressList);

            CancelAdd();
            await GetGrid();
            await grid.RefreshDataAsync();
        }
        catch (Exception ex)
        {
            ToastService.Notify(new ToastMessage()
                {
                    Type = ToastType.Danger,
                    Message = "Error inesperado al realizar la acción",
                    Title = "Error"
                });
        }
    }

    private void CancelAdd()
    {
        createFile = null!;
    }

    private void ChangeDatePlus() => filterDate = filterDate.AddMonths(1);
    private void ChangeDateLess() => filterDate = filterDate.AddMonths(-1);

    private void ShowError(string title, string message)
    {
        ToastService.Notify(new ToastMessage()
            {
                Type = ToastType.Danger,
                Message = message,
                Title = title
            });
    }

    private async Task ToggleContentAsync() => await collapseAgregar.ToggleAsync();
}