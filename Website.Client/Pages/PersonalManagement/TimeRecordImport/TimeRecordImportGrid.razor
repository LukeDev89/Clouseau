            // _projectTask = await _projectTaskService.GetByUserIdAsync(_authService.User.Id);
            // _workDays = await _projectTaskService.UserCalendar(_authService.User.Id);
            // _workPerTask = await _projectTaskService.UserCalendarPerTask(_authService.User.Id);

            CalculateTables();
        }
        catch (Exception ex)
        {
            ToastService.Notify(new ToastMessage()
                {
                    Type = ToastType.Danger,
