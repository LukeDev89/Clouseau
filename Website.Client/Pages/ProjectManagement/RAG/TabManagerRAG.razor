@using BlazorBootstrap;
@using DataService.Auth;
@using DataService.State;
@using Website.Client.Pages.ProjectManagement.RAG.RagStatus;
@using Website.Client.Pages.ProjectManagement.RAG.RagTemplates;   
@using Website.Client.Pages.ProjectManagement.RAG.RagFactor;

@inject AuthService _authService
@inject ChangedState changedState

@implements IDisposable
@inject ChangedState changedState

<BlazorBootstrap.Tabs EnableFadeEffect="true" OnShowing="@(args => OnTabShowingAsync(args))">

    @if (_authService.User.ProfileId == (long)DataModel.Enums.ProfileTypes.Administrador ||
    _authService.User.ProfileId == (long)DataModel.Enums.ProfileTypes.GestorProyectos)
    {
            <BlazorBootstrap.Tab Title="Rag Status" IsActive="true">
            <Content>
                <RagStatus />
            </Content>
        </BlazorBootstrap.Tab>

        <BlazorBootstrap.Tab Title="Rag Templates" IsActive="true">
            <Content>
                <RagTemplates />
            </Content>
        </BlazorBootstrap.Tab>

        <BlazorBootstrap.Tab Title="Rag Factores de Evaluación" IsActive="true">
            <Content>
                <RagFactor />
            </Content>
        </BlazorBootstrap.Tab>
    }
</BlazorBootstrap.Tabs>

<div class="row tabRelleno" style="height:80px">
    <div class="col-12">

    </div>
</div> 

@code 
{
    protected override void OnInitialized()
    {
        changedState.ChangeAction += StateHasChanged;
    }

    public void Dispose()
    {
        changedState.ChangeAction -= StateHasChanged;
    }

    private void OnTabShowingAsync(TabsEventArgs args)
    {
        changedState.InitChanges();
    }
}