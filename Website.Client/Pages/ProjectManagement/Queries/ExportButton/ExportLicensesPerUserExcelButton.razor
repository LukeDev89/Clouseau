@using BlazorBootstrap
@using DataContext
@using DataModel.Dto
@using DataModel.Enums
@using DataService.Auth
@using DataService.Interfaces.Management
@using DataService.Interfaces.ProjectManagement
@using System.Globalization
@using OfficeOpenXml;
@using OfficeOpenXml.Table;
@using System.IO;

@inject IJSRuntime JS

<div class="row">
    <div class="col-12">
        <Button Class="btn btn-success w-100" @onclick="DownloadExcel">Descargar Excel</Button>
    </div>
</div>

@code {
    [Parameter] public List<UserNonworkingDay> UserNonworkingDays { get; set; }

    private async Task DownloadExcel()
    {
        ExcelPackage.LicenseContext = LicenseContext.NonCommercial;

        using var package = new ExcelPackage();
        var worksheet = package.Workbook.Worksheets.Add("Licencias");

        worksheet.Cells[1, 1].Value = "Integrante";
        worksheet.Cells[1, 2].Value = "Tipo";
        worksheet.Cells[1, 3].Value = "Solicitado";
        worksheet.Cells[1, 4].Value = "Desde";
        worksheet.Cells[1, 5].Value = "Hasta";
        worksheet.Cells[1, 6].Value = "Comentario";
        worksheet.Cells[1, 7].Value = "Comentario CFO";
        worksheet.Cells[1, 8].Value = "Documentación";


        for (int i = 0; i < UserNonworkingDays.Count; i++)
        {
            worksheet.Cells[i + 2, 1].Value = UserNonworkingDays[i].UserFullname;
            worksheet.Cells[i + 2, 2].Value = UserNonworkingDays[i].TypeName;
            worksheet.Cells[i + 2, 3].Value = UserNonworkingDays[i].Created.ToString("dd/MM/yyyy");
            worksheet.Cells[i + 2, 4].Value = UserNonworkingDays[i].DateFrom.ToString("dd/MM/yyyy");
            worksheet.Cells[i + 2, 5].Value = UserNonworkingDays[i].DateTo.ToString("dd/MM/yyyy");
            worksheet.Cells[i + 2, 6].Value = UserNonworkingDays[i].Comment;
            worksheet.Cells[i + 2, 7].Value = UserNonworkingDays[i].CommentCfo;
            worksheet.Cells[i + 2, 8].Value = string.IsNullOrEmpty(UserNonworkingDays[i].Path) ? "No" : "Si";
        }

        worksheet.Cells[worksheet.Dimension.Address].AutoFitColumns();

        var stream = new MemoryStream();
        package.SaveAs(stream);
        var fileBytes = stream.ToArray();

        var base64 = Convert.ToBase64String(fileBytes);

        await JS.InvokeVoidAsync("downloadFileFromStream", base64, "Licencias.xlsx");
    }
}