@code {
    [Inject] ToastService ToastService { get; set; }
    [Inject] protected PreloadService PreloadService { get; set; }

    private bool _errorOccurred = false;

    private bool showExtraHoursPerUser = false;
    private bool showLicensesPerUser = false;
    private bool showHourPerTaskPerUser = false;
    private bool showHourPerProjectPerUser = false;
    private bool showPlanillaSemanal = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            PreloadService.Show();
            await base.OnInitializedAsync();
        }
        catch (Exception ex)
        {
            _errorOccurred = true;
        }
        finally
        {
            PreloadService.Hide();
        }
    }

    private void LoadExtraHoursPerUser()
    {
        showExtraHoursPerUser = !showExtraHoursPerUser;
    }
    
    private void LoadLicensesPerUser()
    {
        showLicensesPerUser = !showLicensesPerUser;
    }

    private void LoadHourPerTaskPerUser()
    {
        showHourPerTaskPerUser = !showHourPerTaskPerUser;
    }

    private void LoadHourPerProjectPerUser()
    {
        showHourPerProjectPerUser = !showHourPerProjectPerUser;
    }

    private void LoadPlanillaSenamal()
    {
        showPlanillaSemanal = !showPlanillaSemanal;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (_errorOccurred)
            {
                await localStorage.ClearAsync();

                ToastService.Notify(new ToastMessage()
                    {
                        Type = ToastType.Danger,
                        Message = "Error inesperado al realizar la acción",
                        Title = "Error"
                    });

                navigationManager.NavigateTo("/");
            }
            else
            {
                if (!authService.IsLoggedIn)
                {
                    navigationManager.NavigateTo("/");
                }
                else
                {
                    var uri = navigationManager.Uri;
                    await localStorage.SetItemAsync("lastUrl", uri);
                    await localStorage.SetItemAsync("huboRecarga", false);
                }
            }
        }
    }
}