@page "/project/queries"
@using BlazorBootstrap;
@using DataService.Auth;

@inject AuthService authService
@inject NavigationManager navigationManager
@inject Blazored.LocalStorage.ILocalStorageService localStorage

<h3>Consultas</h3>

<br />

<div class="row custom-container" style="padding: 20px !important">
    <div class="col-12">
        <Button Class="btn btn-primary w-100" @onclick="LoadExtraHoursPerUser">Horas Extra por Usuario</Button>
        @if (showExtraHoursPerUser)
        {
            <br/>
            <br/>
            <ExtraHoursPerUser />
        }
    </div>
</div>

<br />

<div class="row custom-container" style="padding: 20px !important">
    <div class="col-12">
        <Button Class="btn btn-primary w-100" @onclick="LoadLicensesPerUser">Licencias por Usuario</Button>
        @if (showLicensesPerUser)
        {
            <br/>
            <br/>
            <LicensesPerUser />
        }
    </div>
</div>

<br />

<div class="row custom-container" style="padding: 20px !important">
    <div class="col-12">
        <Button Class="btn btn-primary w-100" @onclick="LoadHourPerTaskPerUser">Horas por Tarea por Usuario</Button>
        @if (showHourPerTaskPerUser)
        {
            <br />
            <br />
            <HourPerTaskPerUser />
        }
    </div>
</div>

<br />

<div class="row custom-container" style="padding: 20px !important">
    <div class="col-12">
        <Button Class="btn btn-primary w-100" @onclick="LoadPlanillaSenamal">Planilla Semanal de Servicio</Button>
        @if (showPlanillaSemanal)
        {
            <br />
            <br />
            <PlanillaSemanalServicio />
        }
    </div>
</div>

