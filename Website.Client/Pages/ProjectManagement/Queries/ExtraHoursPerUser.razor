@using BlazorBootstrap
@using DataContext
@using DataModel.Dto
@using DataModel.Enums
@using DataService.Auth
@using DataService.Interfaces.Management
@using DataService.Interfaces.ProjectManagement
@using System.Globalization
@using OfficeOpenXml;
@using OfficeOpenXml.Table;
@using System.IO;
@using Website.Client.Pages.ProjectManagement.Queries.ExportButton

@inherits Queries

@inject IProjectTaskService _projectTaskService
@inject ITaskProgressService _taskProgressService
@inject ITaskTypeService _taskTypeService
@inject IUserService _userService
@inject AuthService _authService
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject IJSRuntime JS
@inject NavigationManager navigationManager

<div class="row">
    <div class="col-2">
        Desde
    </div>
    <div class="col-2">
        Hasta
    </div>
</div>
<div class="row">
    <div class="col-2">
        <DateInput Class="form-control" @bind-Value="@fromDate"></DateInput>
    </div>
    <div class="col-2">
        <DateInput Class="form-control" @bind-Value="@toDate"></DateInput>
    </div>
    <div class="col-2">
        <Button Class="btn btn-primary w-100" @onclick="onFilter">Filtrar</Button>
    </div>
    <div class="col-2">
        <Button Class="btn btn-secondary w-100" @onclick="onClear">Limpiar</Button>
    </div>
    <div class="col-2">
        <ExportExtraHoursPerUserExcelButton ExtraHours="_extraHours" />
    </div>
</div>

<br />
<br />

<div class="row" style="overflow-x: auto;">
    <div class="col-12">
        <table class="table table-hover table-bordered table-striped text-nowrap sticky-table">
            <thead>
                <tr>
                    <th>Integrante</th>
                    <th>Fecha</th>
                    <th>Horas</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in _extraHours)
                {
                    <tr>
                        <td>@e.Integrante</td>
                        <td>@e.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>@e.Horas</td>
                        <td>@e.Estado</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    [Inject] ToastService ToastService { get; set; }
    [Inject] protected PreloadService PreloadService { get; set; }

    private bool _errorOccurred = false;

    private DateOnly fromDate = new DateOnly(DateTime.Now.Year, DateTime.Now.Month, 1);
    private DateOnly toDate = DateOnly.FromDateTime(DateTime.Now);


    private List<ExtraHoursView> _extraHours = new List<ExtraHoursView>();

    private int _month = DateTime.Now.Month;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (_errorOccurred)
            {
                await localStorage.ClearAsync();

                ToastService.Notify(new ToastMessage()
                    {
                        Type = ToastType.Danger,
                        Message = "Error inesperado al realizar la acción",
                        Title = "Error"
                    });

                navigationManager.NavigateTo("/");
            }
            else
            {
                if (!_authService.IsLoggedIn)
                {
                    navigationManager.NavigateTo("/");
                }
                else
                {
                    var uri = navigationManager.Uri;
                    await localStorage.SetItemAsync("lastUrl", uri);
                    await localStorage.SetItemAsync("huboRecarga", false);
                }
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            PreloadService.Show();
            await GetGrid();
            await GetCombo();
            await base.OnInitializedAsync();
        }
        catch (Exception ex)
        {
            _errorOccurred = true;
        }
        finally
        {
            PreloadService.Hide();
        }
    }

    private async Task GetCombo()
    {

    }

    private async Task GetGrid()
    {
        try
        {
            _extraHours = await _taskProgressService.GetExtraHoursView(fromDate.ToDateTime(TimeOnly.MinValue), toDate.ToDateTime(TimeOnly.MinValue));

            if (_authService.User.ProfileId == (short)ProfileTypes.GestorProyectos)
            {
                var extraHoursGestor = new List<ExtraHoursView>();

                var users = await _userService.GetAsync();

                foreach (var e in _extraHours)
                {
                    var user = users.First(x => x.UserFullName == e.Integrante);

                    var isSubaltern = user.Superior == _authService.User.Id;

                    if (!isSubaltern) continue;

                    extraHoursGestor.Add(e);
                }

                _extraHours = extraHoursGestor;
            }
        }
        catch (Exception ex)
        {
            ToastService.Notify(new ToastMessage()
                {
                    Type = ToastType.Danger,
                    Message = "Error inesperado al realizar la acción",
                    Title = "Error"
                });
        }
    }

    private async Task onFilter()
    {
        try
        {
            await GetGrid();

            StateHasChanged();
        }
        catch (Exception ex)
        {
            ToastService.Notify(new ToastMessage()
                {
                    Type = ToastType.Danger,
                    Message = "Error inesperado al realizar la acción",
                    Title = "Error"
                });
        }
    }

    private async Task onClear()
    {
        try
        {
            fromDate = new DateOnly(DateTime.Now.Year, DateTime.Now.Month, 1);
            toDate = DateOnly.FromDateTime(DateTime.Now);

            await GetGrid();

            StateHasChanged();
        }
        catch (Exception ex)
        {
            ToastService.Notify(new ToastMessage()
                {
                    Type = ToastType.Danger,
                    Message = "Error inesperado al realizar la acción",
                    Title = "Error"
                });
        }
    }
}
