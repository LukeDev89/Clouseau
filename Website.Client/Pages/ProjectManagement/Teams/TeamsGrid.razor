@using BlazorBootstrap

@using DataContext
@using DataService.Interfaces.Management;
@using DataService.State;
@using DataService.Interfaces.ProjectManagement;

@inherits Teams

@inject ITeamService _service
@inject IUserService _userService

@inject ChangedState changedState

<br />

<div class="row">
	<div class="col-12">
		<Button Class="form-control" Type="ButtonType.Button" Color="ButtonColor.Primary" @onclick="ToggleContentAsync">Crear Equipo</Button>
	</div>
</div>
<Collapse @ref="collapseAgregar">
	<Card>
		<CardBody>
			<div class="row">
				<div class="col-6">
					Nombre
				</div>
			</div>
			<div class="row mt-2">
				<div class="col-9">
					<InputText Class="form-control" @bind-Value="@createName"></InputText>
				</div>

				<div class="col-3">
					<div class="row">
						<div class="col-6">
							<Button Class="btn btn-secondary form-control" onclick="@(() => CancelAdd())">
								Limpiar
							</Button>
						</div>
						<div class="col-6">
							<Button Class="btn btn-primary form-control" onclick="@(() => SaveAdd())">
								Crear
							</Button>
						</div>
					</div>
				</div>
			</div>
		</CardBody>
	</Card>
</Collapse>

<br />
<br />

<Grid TItem="Team" @ref="grid"
    Class="table table-hover table-bordered table-striped"
    Data="_teams"
    AllowSorting="true"
    AllowFiltering="true"
    AllowPaging="true"
    PageSize="8"
    Responsive="true">

	<GridColumn TItem="Team" HeaderText="Equipo" SortKeySelector="item => item.Name" PropertyName="Name" FilterOperator="FilterOperator.Contains">
		@context.Name
	</GridColumn>

	<GridColumn TItem="Team" HeaderText="Usuarios" Sortable="false" Filterable="false">
		<div class="tooltip-container">
			<div class="row">
				<div class="col-12 d-flex align-items-center justify-content-center tooltip-text">
					<span>
						@if (context.UserTeams.Count == 0)
						{

						}
						else if (context.UserTeams.Count > 0)
							foreach (var u in context.UserTeams)
							{
								<div>
									@u.User.Firstname @u.User.Lastname (@u.User.Username) <br />
								</div>
							}
					</span>
				</div>
			</div>
			<span class="oi oi-info" aria-hidden="true"></span>
		</div>
	</GridColumn>

	<GridColumn TItem="Team" HeaderText="Creado" SortKeySelector="item => item._Created" PropertyName="_Created" FilterOperator="FilterOperator.Equals">
		@context.Created.ToString("dd/MM/yyyy")
	</GridColumn>

	<GridColumn TItem="Team" HeaderText="Baja" SortKeySelector="item => item._Deleted" PropertyName="_Deleted" FilterOperator="FilterOperator.Equals">
		@context.Deleted?.ToString("dd/MM/yyyy")
	</GridColumn>

	<GridColumn TItem="Team" HeaderText="Activo" SortKeySelector="item => item.Active" PropertyName="Active" FilterOperator="FilterOperator.Equals">

		@if (context.Active)
		{
			<span class="oi oi-circle-check" aria-hidden="true" style="color: var(--l-green)"></span>
		}
		else
		{
			<span class="oi oi-circle-x" aria-hidden="true" style="color: var(--l-red)"></span>
		}
	</GridColumn>

	<GridColumn TItem="Team" HeaderText="Acciones" Sortable="false" Filterable="false">
		<div class="row">
			<div class="col-12 d-flex">
				<Button @onclick="async () => await OnShowModalClick(context.Id, context.Name, context.Active, context.UserTeams.ToList())">
					<span class="oi oi-pencil" aria-hidden="true" title="Editar"></span>
				</Button>
				<Button @onclick="async () => await OpenUsersModal(context.Id, context.Name, context.UserTeams.ToList())">
					<span class="oi oi-person" aria-hidden="true" title="Editar Usuarios"></span>
				</Button>
				@if (!context.Active)
				{
					<Button @onclick="async () => await SaveDefinitiveDelete(context.Id)">
						<span class="oi oi-trash" aria-hidden="true" title="Eliminar" style="color: var(--l-yellow)"></span>
					</Button>
				}
				else
				{
					<Button @onclick="async () => await SaveDelete(context.Id)">
						<span class="oi oi-circle-x" aria-hidden="true" title="Eliminar" style="color: var(--l-red)"></span>
					</Button>
				}
			</div>
		</div>
	</GridColumn>
</Grid>

<Modal @ref="modalTeam" Title="Editar Equipo" Size="ModalSize.Large">
	<BodyTemplate>
		<div class="row">
			<div class="col-12">
				<h4><b>@modalName</b></h4>
				<div style="display: none">
					@modalId
				</div>
			</div>
		</div>

		<div class="row pt-2">
			<div class="col-4 d-flex align-items-center">
				Nombre
			</div>
			<div class="col-8">
				<InputText Class="form-control" @bind-Value="@modalName"></InputText>
			</div>
		</div>

		<div class="row pt-2">
			<div class="col-4 d-flex align-items-center">
				Activo
			</div>
			<div class="col-8 d-flex align-items-center">
				<div class="form-check">
					@if (modalActive)
					{
						<input class="form-check-input" type="checkbox" checked @onchange="@(async (e) =>
                            await ToggleActiveAsync(false))" />
					}
					else
					{
						<input class="form-check-input" type="checkbox" @onchange="@(async (e) =>
                            await ToggleActiveAsync(true))" />
					}
				</div>
			</div>
		</div>

		<div class="row pt-3">
			<div class="col-12" style="margin-top: 20px">
				<h5>Usuarios Asignados</h5>
			</div>
		</div>
		<div class="row pt-2">
			<div class="col-12">
				@if (_modalUsersTeam.Count == 0)
				{
					<div class="row">
						<div class="col-12 d-flex align-items-center">
							No hay usuarios asignados
						</div>
					</div>
				}
				else if (_modalUsersTeam.Count > 0)
					foreach (var u in _modalUsersTeam)
					{
						<div class="row">
							<div class="col-12 d-flex align-items-center">
								@u.User.UserFullName (@u.User.Username)
							</div>
						</div>
					}
			</div>
		</div>
	</BodyTemplate>
	<FooterTemplate>
		<div class="col-3">
			<Button Class="btn form-control" Color="ButtonColor.Secondary" @onclick="OnHideModalClick">Cerrar</Button>
		</div>
		<div class="col-3">
			<Button Class="btn form-control" Color="ButtonColor.Primary" @onclick="SaveEdit">Guardar</Button>
		</div>
	</FooterTemplate>
</Modal>

<Modal @ref="modalUserTeam" Title="Editar Equipo" Size="ModalSize.Large">
	<BodyTemplate>
		<div class="row">
			<div class="col-12">
				<h4><b>@modalName</b></h4>
				<div style="display: none">
					@modalId
				</div>
			</div>
		</div>

		<div class="row pt-2">
			<div class="col-12">
				Agregar Usuarios
			</div>
		</div>
		<div class="row pt-2">
			<div class="col-6">
				<InputSelect class="form-select" @bind-Value="addUserId">
					<option selected value=-1 disabled>Seleccione</option>
					@foreach (var u in _users.Where(u => u.IsActive && !_modalUsersTeam.Any(m => m.UserId == u.Id)).OrderBy(x => x.UserFullName))
					{
						<option value=@u.Id>@u.UserFullName (@u.Username)</option>
					}
				</InputSelect>
			</div>

			<div class="col-3 d-flex align-items-center">
				<div class="form-check">
					<input id="flexCheckTemporary"
						   class="form-check-input"
						   type="checkbox"
						   @bind="modalTemporary"
						   @bind:event="onchange" />
				</div>
				<label class="form-check-label" for="flexCheckTemporary">
					Es Temporal
				</label>
			</div>

			<div class="col-3 d-flex align-items-center">
				<div class="form-check">
					<input id="flexCheckRequireManagnment"
						   class="form-check-input"
						   type="checkbox"
						   @bind="modalRequireManagnment"
						   @bind:event="onchange" />
				</div>
				<label class="form-check-label" for="flexCheckRequireManagnment">
					Requiere Gestión
				</label>
			</div>			
		</div>

		<br />

		<div class="col-3">
			<Button Class="btn btn-primary form-control" onclick="@(() => AddUser())">
				Agregar
			</Button>
		</div>

		<div class="row pt-4">
			<div class="col-12" style="margin-top: 20px">
				<h5>Usuarios Asignados</h5>
			</div>

		</div>
		<div class="row pt-2">
			<div class="col-12">
				@if (_modalUsersTeam.Count == 0)
				{
					<div class="row">
						<div class="col-12 d-flex align-items-center">
							No hay usuarios asignados
						</div>
					</div>
				}
				else if (_modalUsersTeam.Count > 0)
					foreach (var u in _modalUsersTeam)
					{
						<div class="row pt-1">
							<div class="col-6 d-flex align-items-center">
								@u.User.UserFullName (@u.User.Username)
							</div>
							<div class="col-1 d-flex align-items-center">
								@if (u.Temporary)
								{
									<div>
										Temporal
									</div>
								}
							</div>
							<div class="col-3 d-flex align-items-center" style="padding-left:40px">
								@if (u.RequireManagement)
								{
									<div>
										Requiere Gestión
									</div>
								}
							</div>
							<div class="col-2 d-flex align-items-center">
								<Button Class="btn form-control" Color="ButtonColor.Primary" @onclick="@(() => DeleteUser(u.TeamId, u.UserId))">
									<div class="row">
										<div class="col-12 d-flex align-items-center justify-content-center">
											<span class="oi oi-circle-x" aria-hidden="true" style="color: var(--l-white)"></span>
										</div>
									</div>
								</Button>
							</div>
						</div>
					}
			</div>
		</div>
	</BodyTemplate>
	<FooterTemplate>
		<div class="col-3">
			<Button Class="btn form-control" Color="ButtonColor.Secondary" @onclick="OnHideModalClick">Cerrar</Button>
		</div>
	</FooterTemplate>
</Modal>

@code {
	[Inject] ToastService ToastService { get; set; }
	private Collapse collapseAgregar;
	private Grid<Team> grid;
	private Modal modalTeam;
	private Modal modalUserTeam;

	private long modalId { get; set; }
	private string modalName { get; set; }
	private bool modalActive { get; set; }
	private bool modalTemporary { get; set; }
	private bool modalRequireManagnment { get; set; }

	private DateTime? rollOn { get; set; }
	private DateTime? rollOff { get; set; }
	private int assignmentSold { get; set; }
	private int realAssignment { get; set; }
	private string comments { get; set; }

	private long addUserId { get; set; } = -1;
	private string createName { get; set; } = "";
	private string createDescription { get; set; } = "";

	private List<UserTeam> _modalUsersTeam = new List<UserTeam>();
	private List<Team> _teams = new List<Team>();
	private List<User> _users = new List<User>();

	protected override async Task OnInitializedAsync()
	{
		await GetGrid();
		await GetCombos();
		await base.OnInitializedAsync();
	}

	private async Task GetCombos()
	{
		try
		{
			_users = await _userService.GetAsync();
		}
		catch (Exception ex)
		{
			ToastService.Notify(new ToastMessage()
				{
					Type = ToastType.Danger,
					Message = "Error inesperado al realizar la acción",
					Title = "Error"
				});
		}
	}

	private async Task GetGrid()
	{
		try
		{
			_teams = await _service.GetAsync();
		}
		catch (Exception ex)
		{
			ToastService.Notify(new ToastMessage()
				{
					Type = ToastType.Danger,
					Message = "Error inesperado al realizar la acción",
					Title = "Error"
				});
		}
	}

	private async Task SaveAdd()
	{
		try
		{
			await _service.AddAsync(createName);
			await GetGrid();
			await grid.RefreshDataAsync();

			changedState.InitChanges();

			CancelAdd();

			ToastService.Notify(new ToastMessage()
				{
					Type = ToastType.Success,
					Message = $"Acción realizada con éxito.",
					Title = "Crear Equipo"
				});
		}
		catch (Exception ex)
		{
			ToastService.Notify(new ToastMessage()
				{
					Type = ToastType.Danger,
					Message = "Error inesperado al realizar la acción",
					Title = "Error"
				});
		}
	}

	private async Task AddUser()
	{
		if (addUserId != -1)
		{
			try
			{
				await _service.AddUsersAsync(modalId, addUserId, modalTemporary, modalRequireManagnment);
				await GetGrid();
				await grid.RefreshDataAsync();

				_modalUsersTeam = new List<UserTeam>();
				_modalUsersTeam = _teams.First(x => x.Id == modalId).UserTeams.ToList();
				_modalUsersTeam = _modalUsersTeam.OrderBy(x => x.User.UserFullName).ToList();

				StateHasChanged();
				changedState.InitChanges();

				addUserId = -1;

				ToastService.Notify(new ToastMessage()
					{
						Type = ToastType.Success,
						Message = $"Acción realizada con éxito.",
						Title = "Editar Equipos - Asignar Usuario"
					});
			}
			catch (Exception ex)
			{
				ToastService.Notify(new ToastMessage()
					{
						Type = ToastType.Danger,
						Message = "Error inesperado al realizar la acción",
						Title = "Error"
					});
			}
		}
	}

	private async Task DeleteUser(long id, long userId)
	{
		try
		{
			await _service.DeleteUsersAsync(id, userId);
			await GetGrid();
			await grid.RefreshDataAsync();

			_modalUsersTeam = new List<UserTeam>();
			_modalUsersTeam = _teams.First(x => x.Id == id).UserTeams.ToList();
			StateHasChanged();
			changedState.InitChanges();

			ToastService.Notify(new ToastMessage()
				{
					Type = ToastType.Success,
					Message = $"Acción realizada con éxito.",
					Title = "Editar Equipos -´Quitar Usuario"
				});
		}
		catch (Exception ex)
		{
			ToastService.Notify(new ToastMessage()
				{
					Type = ToastType.Danger,
					Message = "Error inesperado al realizar la acción",
					Title = "Error"
				});
		}
	}

	private void CancelAdd()
	{
		createName = "";
	}

	private async Task OpenUsersModal(long id, string name, List<UserTeam> users)
	{
		modalId = id;
		modalName = name;
		_modalUsersTeam = users;

		await modalUserTeam?.ShowAsync();
	}

	private async Task SaveEdit()
	{
		try
		{
			await _service.EditAsync(modalId, modalName, modalActive);
			await GetGrid();
			await grid.RefreshDataAsync();
			await OnHideModalClick();

			ToastService.Notify(new ToastMessage()
				{
					Type = ToastType.Success,
					Message = $"Acción realizada con éxito.",
					Title = "Editar Equipo"
				});
		}
		catch (Exception ex)
		{
			ToastService.Notify(new ToastMessage()
				{
					Type = ToastType.Danger,
					Message = "Error inesperado al realizar la acción",
					Title = "Error"
				});
		}
	}

	private async Task SaveDelete(long Id)
	{
		try
		{
			await _service.DeleteAsync(Id);

			await GetGrid();
			await grid.RefreshDataAsync();
			await OnHideModalClick();

			ToastService.Notify(new ToastMessage()
				{
					Type = ToastType.Success,
					Message = $"Acción realizada con éxito.",
					Title = "Eliminar Equipo"
				});
		}
		catch (Exception ex)
		{
			ToastService.Notify(new ToastMessage()
				{
					Type = ToastType.Danger,
					Message = "Error inesperado al realizar la acción",
					Title = "Error"
				});
		}
	}

	private async Task SaveDefinitiveDelete(long Id)
	{
		try
		{
			await _service.DefinitiveDeleteAsync(Id);

			await GetGrid();
			await grid.RefreshDataAsync();
			await OnHideModalClick();

			ToastService.Notify(new ToastMessage()
				{
					Type = ToastType.Success,
					Message = $"Acción realizada con éxito.",
					Title = "Eliminar Equipo"
				});
		}
		catch (Exception ex)
		{
			ToastService.Notify(new ToastMessage()
				{
					Type = ToastType.Danger,
					Message = "Revise si el equipo tiene usuarios asignados, desasignelos y vuelva a intentar.",
					Title = "Error"
				});
		}
	}

	private async Task OnShowModalClick(long id, string name, bool active, List<UserTeam> users)
	{
		modalId = id;
		modalName = name;
		modalActive = active;

		_modalUsersTeam = users;

		await modalTeam?.ShowAsync();
	}

	private async Task OnHideModalClick()
	{
		modalId = 0;
		modalName = "";
		modalActive = false;
		addUserId = -1;
		_modalUsersTeam = new List<UserTeam>();

		await modalTeam?.HideAsync();
		await modalUserTeam?.HideAsync();
	}

	private async Task ToggleContentAsync() => await collapseAgregar.ToggleAsync();

	async Task ToggleActiveAsync(bool active)
	{
		if (active)
		{
			modalActive = true;
		}
		else
		{
			modalActive = false;
		}
	}

}