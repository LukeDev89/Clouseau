@code {
    [Inject] ToastService ToastService { get; set; }
    [Inject] protected PreloadService PreloadService { get; set; }

    private Modal modal;
    private Grid<GadgetExpress> grid;
    private Collapse collapseAgregar;

    private List<GadgetExpress> _gadgetExpress = new List<GadgetExpress>();
    private List<Role> _roles = new List<Role>();
    private List<Team> _teams = new List<Team>();

    private GadgetExpress modalGadget { get; set; }
    private GadgetExpress newGadget { get; set; } = new GadgetExpress();
    private TimeOnly newStartTime { get; set; }
    private TimeOnly? newEndTime { get; set; }

    private int newTeamId { get; set; } = -1;
    private int newRoleId { get; set; } = -1;

    public DateTime modalDate { get; set; } = DateTime.Now;
    public DateTime? modalDateTo { get; set; } = null;
    public decimal modalHours { get; set; }

    private bool _errorOccurred = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (_errorOccurred)
            {
                await localStorage.ClearAsync();

                ToastService.Notify(new ToastMessage()
                    {
                        Type = ToastType.Danger,
                        Message = "Error inesperado al realizar la acción",
                        Title = "Error"
                    });

                navigationManager.NavigateTo("/");

            }
            else
            {
                if (!_authService.IsLoggedIn)
                {
                    navigationManager.NavigateTo("/");
                }
                else
                {
                    var uri = navigationManager.Uri;
                    await localStorage.SetItemAsync("lastUrl", uri);
                    await localStorage.SetItemAsync("huboRecarga", false);
                }
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            PreloadService.Show();
            await GetGrid();
            await base.OnInitializedAsync();
        }
        catch (Exception ex)
        {
            _errorOccurred = true;
        }
        finally
        {
            PreloadService.Hide();
        }
    }

    private async Task GetGrid()
    {
        try
        {
            _gadgetExpress = await _gadgetExpressService.GetAll();
        }
        catch (Exception ex)
        {
            ToastService.Notify(new ToastMessage()
                {
                    Type = ToastType.Danger,
                    Message = "Error inesperado al realizar la acción",
                    Title = "Error"
                });
        }
    }

    private async Task OnForceSend(GadgetExpress model)
    {
        await _gadgetExpressService.Send(model);

        ToastService.Notify(new ToastMessage()
            {
                Type = ToastType.Success,
                Message = "Notificación enviada con éxito",
                Title = "Notificación"
            });
    }

    private async Task OnDesactiveNotification(GadgetExpress model)
    {
        model.ActiveMonday = false;
        model.ActiveTuesday = false;
        model.ActiveWednesday = false;
        model.ActiveThursday = false;
        model.ActiveFriday = false;

        await _gadgetExpressService.Update(model);

        ToastService.Notify(new ToastMessage()
            {
                Type = ToastType.Success,
                Message = "Notificación desactivada con éxito",
                Title = "Notificación"
            });

        await GetGrid();
        await grid.RefreshDataAsync();
    }

    private async Task SaveModal()
    {
        try
        {
            await _gadgetExpressService.Update(modalGadget);

            await OnHideModalClick();

            ToastService.Notify(new ToastMessage()
                {
                    Type = ToastType.Success,
                    Message = $"Horas cargadas con éxito.",
                    Title = "Regisro de Horas"
                });

            await GetGrid();
            await grid.RefreshDataAsync();
        }
        catch (Exception ex)
        {
            ToastService.Notify(new ToastMessage()
                {
                    Type = ToastType.Danger,
                    Message = "Error inesperado al realizar la acción",
                    Title = "Error"
                });
        }
    }

    private async Task OnShowModalClick(GadgetExpress model)
    {
        modalGadget = model;

        await modal?.ShowAsync();
    }

    private async Task OnHideModalClick()
    {
        modalGadget = new GadgetExpress();

        await modal?.HideAsync();
    }

    private async Task CreateNotification()
    {
        try
        {
            newGadget.StartTime = newStartTime.ToTimeSpan();
            newGadget.EndTime = newEndTime?.ToTimeSpan();

            await _gadgetExpressService.Add(newGadget);

            ToastService.Notify(new ToastMessage()
                {
                    Type = ToastType.Success,
                    Message = "Notificación creada con éxito",
                    Title = "Notificación"
                });

            await GetGrid();
            await grid.RefreshDataAsync();
        }
        catch (Exception ex)
        {
            ToastService.Notify(new ToastMessage()
                {
                    Type = ToastType.Danger,
                    Message = "Error inesperado al realizar la acción",
                    Title = "Error"
                });
        }
    }

    private async Task CancelAdd()
    {
        newGadget = new GadgetExpress();
        newStartTime = new TimeOnly();
        newEndTime = new TimeOnly();
    }

    private async Task ToggleContentAsync() => await collapseAgregar.ToggleAsync();
}