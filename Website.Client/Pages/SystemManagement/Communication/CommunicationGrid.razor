<br />

<div class="row">
    <div class="col-12">
        <Button Class="form-control" Type="ButtonType.Button" Color="ButtonColor.Primary" @onclick="ToggleContentAsync">
            Crear Notificación
        </Button>
    </div>
</div>
<Collapse @ref="collapseAgregar">
    <Card>
        <CardBody>
            <div class="row">
                <div class="col-3">
                    Título
                </div>
                <div class="col-9">
                    Mensaje
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-3">
                    <InputText Class="form-control" @bind-Value="@newGadget.Title"></InputText>
                </div>
                <div class="col-9">
                    <InputText Class="form-control" @bind-Value="@newGadget.Message"></InputText>
                </div>
            </div>
            <div class="row mt-4">
                <div class="col-12">
                    Descripción
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-12">
                    <InputText Class="form-control" @bind-Value="@newGadget.Description"></InputText>
                </div>
            </div>
            <div class="row mt-4">
                <div class="col-3">
                    Fecha Inicio
                </div>
                <div class="col-3">
                    Hora Inicio
                </div>
                <div class="col-3">
                    Fecha Fin
                </div>
                <div class="col-3">
                    Hora Fin
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-3">
                    <DateInput Class="form-control" @bind-Value="@newGadget.StartDay"></DateInput>
                </div>
                <div class="col-3">
                    <TimeInput Class="form-control" @bind-Value="@newStartTime"></TimeInput>
                </div>
                <div class="col-3">
                    <DateInput Class="form-control" @bind-Value="@newGadget.EndDay"></DateInput>
                </div>
                <div class="col-3">
                    <TimeInput Class="form-control" @bind-Value="@newEndTime"></TimeInput>
                </div>
            </div>
            <div class="row mt-4">
                <div class="col-3">
                    Intervalo Hs
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-3">
                    <InputNumber Class="form-control" @bind-Value="@newGadget.IntervalHours"></InputNumber>
                </div>
            </div>
            <div class="row mt-4">
                <div class="col-2">
                    <div class="form-check">
                        <InputCheckbox Class="form-check-input" id="chkMonday" @bind-Value="@newGadget.ActiveMonday"></InputCheckbox>
                        <label class="form-check-label" for="flexCheckDefault">
                            Lunes
                        </label>
                    </div>
                </div>
                <div class="col-2">
                    <div class="form-check">
                        <InputCheckbox Class="form-check-input" id="chkTuesday" @bind-Value="@newGadget.ActiveTuesday"></InputCheckbox>
                        <label class="form-check-label" for="flexCheckDefault">
                            Martes
                        </label>
                    </div>
                </div>
                <div class="col-2">
                    <div class="form-check">
                        <InputCheckbox Class="form-check-input" id="chkWednesday" @bind-Value="@newGadget.ActiveWednesday"></InputCheckbox>
                        <label class="form-check-label" for="flexCheckDefault">
                            Miercoles
                        </label>
                    </div>
                </div>
                <div class="col-2">
                    <div class="form-check">
                        <InputCheckbox Class="form-check-input" id="chkThursday" @bind-Value="@newGadget.ActiveThursday"></InputCheckbox>
                        <label class="form-check-label" for="flexCheckDefault">
                            Jueves
                        </label>
                    </div>
                </div>
                <div class="col-2">
                    <div class="form-check">
                        <InputCheckbox Class="form-check-input" id="chkFriday" @bind-Value="@newGadget.ActiveFriday"></InputCheckbox>
                        <label class="form-check-label" for="flexCheckDefault">
                            Viernes
                        </label>
                    </div>
                </div>
            </div>
            <div class="row mt-4">
                <div class="col-8"></div>
                <div class="col-4">
                    <div class="row">
                        <div class="col-6">
                            <Button Class="btn btn-secondary form-control" @onclick="async () => await CancelAdd()">
                                Limpiar
                            </Button>
                        </div>
                        <div class="col-6">
                            <Button Class="btn btn-primary form-control" @onclick="async () => await CreateNotification()">
                                Crear
                            </Button>
                        </div>
                    </div>
                </div>
            </div>
        </CardBody>
    </Card>
</Collapse>

<br />
<br />

<Grid TItem="GadgetExpress" @ref="grid"
      Data="_gadgetExpress"
      Class="table table-hover table-bordered table-striped text-nowrap"
      AllowSorting="true"
      AllowFiltering="true"
      AllowPaging="true"
      PageSize="8"
      Responsive="true"
      Unit="Unit.Px">

    <GridColumn TItem="GadgetExpress" FilterTextboxWidth="150" HeaderText="Título" Freeze="true" FreezeLeftPosition="0" TextNoWrap="true" SortKeySelector="item => item.Title" PropertyName="Title" FilterOperator="FilterOperator.Contains">
        @context.Title
    </GridColumn>

    <GridColumn TItem="GadgetExpress" HeaderText="Descripción" Sortable="false" Filterable="false">
        @context.Description
    </GridColumn>

    <GridColumn TItem="GadgetExpress" HeaderText="Mensaje" Sortable="false" Filterable="false">
        @context.Message
    </GridColumn>

    <GridColumn TItem="GadgetExpress" HeaderText="Día Inicio" SortKeySelector="item => item._StartDay" PropertyName="_StartDay" FilterOperator="FilterOperator.Equals">
        @context._StartDay.ToString("dd/MM/yyyy")
    </GridColumn>

    <GridColumn TItem="GadgetExpress" HeaderText="Hora Inicio" Sortable="false" Filterable="false">
        @context._StartTime.ToString("hh:mm")
    </GridColumn>

    <GridColumn TItem="GadgetExpress" HeaderText="Día Fin" Sortable="false" Filterable="false">
        @context._EndDay?.ToString("dd/MM/yyyy")
    </GridColumn>

    <GridColumn TItem="GadgetExpress" HeaderText="Hora Fin" Sortable="false" Filterable="false">
        @context._EndTime?.ToString("hh:mm")
    </GridColumn>

    <GridColumn TItem="GadgetExpress" HeaderText="Intervalo hs" TextAlignment="Alignment.End" Sortable="false" Filterable="false">
        @context.IntervalHours
    </GridColumn>

    <GridColumn TItem="GadgetExpress" HeaderText="Ejecuciones" TextAlignment="Alignment.End" Sortable="false" Filterable="false">
        @context.Executions
    </GridColumn>

    <GridColumn TItem="GadgetExpress" HeaderText="Lunes" SortKeySelector="item => item.ActiveMonday" PropertyName="ActiveMonday" FilterOperator="FilterOperator.Equals">
        @if (context.ActiveMonday)
        {
            <span class="oi oi-circle-check" aria-hidden="true" style="color: var(--l-green)"></span>
        }
        else
        {
            <span class="oi oi-circle-x" aria-hidden="true" style="color: var(--l-red)"></span>
        }
    </GridColumn>

    <GridColumn TItem="GadgetExpress" HeaderText="Martes" SortKeySelector="item => item.ActiveTuesday" PropertyName="ActiveTuesday" FilterOperator="FilterOperator.Equals">
        @if (context.ActiveTuesday)
        {
            <span class="oi oi-circle-check" aria-hidden="true" style="color: var(--l-green)"></span>
        }
        else
        {
            <span class="oi oi-circle-x" aria-hidden="true" style="color: var(--l-red)"></span>
        }
    </GridColumn>

    <GridColumn TItem="GadgetExpress" HeaderText="Miércoles" SortKeySelector="item => item.ActiveWednesday" PropertyName="ActiveWednesday" FilterOperator="FilterOperator.Equals">
        @if (context.ActiveWednesday)
        {
            <span class="oi oi-circle-check" aria-hidden="true" style="color: var(--l-green)"></span>
        }
        else
        {
            <span class="oi oi-circle-x" aria-hidden="true" style="color: var(--l-red)"></span>
        }
    </GridColumn>

    <GridColumn TItem="GadgetExpress" HeaderText="Jueves" SortKeySelector="item => item.ActiveThursday" PropertyName="ActiveThursday" FilterOperator="FilterOperator.Equals">
        @if (context.ActiveThursday)
        {
            <span class="oi oi-circle-check" aria-hidden="true" style="color: var(--l-green)"></span>
        }
        else
        {
            <span class="oi oi-circle-x" aria-hidden="true" style="color: var(--l-red)"></span>
        }
    </GridColumn>

    <GridColumn TItem="GadgetExpress" HeaderText="Viernes" SortKeySelector="item => item.ActiveFriday" PropertyName="ActiveFriday" FilterOperator="FilterOperator.Equals">
        @if (context.ActiveFriday)
        {
            <span class="oi oi-circle-check" aria-hidden="true" style="color: var(--l-green)"></span>
        }
        else
        {
            <span class="oi oi-circle-x" aria-hidden="true" style="color: var(--l-red)"></span>
        }
    </GridColumn>

    <GridColumn TItem="GadgetExpress" HeaderText="Acciones" Sortable="false" Filterable="false">
        <div class="row">
            <div class="col-12 d-flex">
                <Button @onclick="async () => await OnShowModalClick(context)">
                    <span class="oi oi-pencil" aria-hidden="true" title="Editar"></span>
                </Button>

                <Button @onclick="async () => await OnForceSend(context)">
                    <span class="oi oi-bolt" style="color: var(--l-yellow)" aria-hidden="true" title="Forzar Envio"></span>
                </Button>

                <Button @onclick="async () => await OnDesactiveNotification(context)">
                    <span class="oi oi-circle-x" style="color: var(--l-red)" aria-hidden="true" title="Desactivar"></span>
                </Button>
            </div>
        </div>
    </GridColumn>
</Grid>

