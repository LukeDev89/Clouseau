    </Card>
</Collapse>

<br />
<br />

<Grid TItem="User" @ref="grid"
      Class="table table-hover table-bordered table-striped"
      Data="_users"
      AllowSorting="true"
      AllowFiltering="true"
      AllowPaging="true"
      PageSize="8"
      Responsive="true">

    <GridColumn TItem="User" HeaderText="Id" TextNoWrap="true" SortKeySelector="item => item.Id" PropertyName="Id" FilterOperator="FilterOperator.Equals">
        @context.Id
    </GridColumn>

    <GridColumn TItem="User" HeaderText="Nombre" FilterTextboxWidth="150" TextNoWrap="true" SortKeySelector="item => item.UserFullName" PropertyName="UserFullName" FilterOperator="FilterOperator.Contains">
        @context.UserFullName
    </GridColumn>

    <GridColumn TItem="User" HeaderText="Usuario" FilterTextboxWidth="150" TextNoWrap="true" SortKeySelector="item => item.Username" PropertyName="Username" FilterOperator="FilterOperator.Contains">
        @context.Username
    </GridColumn>

    <GridColumn TItem="User" HeaderText="Email" FilterTextboxWidth="150" TextNoWrap="true" SortKeySelector="item => item.Email" PropertyName="Email" FilterOperator="FilterOperator.Contains">
        @context.Email
    </GridColumn>

    <GridColumn TItem="User" HeaderText="Perfil" TextNoWrap="true" SortKeySelector="item => item.Profile.Name" PropertyName="Profile.Name" FilterOperator="FilterOperator.Contains">
        @context.ProfileName
    </GridColumn>

    <GridColumn TItem="User" HeaderText="Rol" TextNoWrap="true" SortKeySelector="item => item.RoleName" PropertyName="Role.Name" FilterOperator="FilterOperator.Contains">
        @context.RoleName
    </GridColumn>

    <GridColumn TItem="User" HeaderText="Activo" SortKeySelector="item => item.IsActive" PropertyName="IsActive" FilterOperator="FilterOperator.Equals">
        @if (context.IsActive)
        {
            <span class="oi oi-circle-check" aria-hidden="true" style="color: var(--l-green)"></span>
        }
        else
        {
            <span class="oi oi-circle-x" aria-hidden="true" style="color: var(--l-red)"></span>
        }
    </GridColumn>

    <GridColumn TItem="User" HeaderText="Responsable" SortKeySelector="item => item.SuperiorName" PropertyName="SuperiorName" Sortable="false" Filterable="false">
        @foreach (var u in _users)
        {
            if (u.Id == context.Superior)
            {
                @u.Firstname @u.Lastname
                break;
            }
        }
    </GridColumn>

    <GridColumn TItem="User" Freeze="true" FreezeRightPosition="0" FreezeDirection="FreezeDirection.Right" HeaderText="Acciones" Sortable="false" Filterable="false">
        <div class="row">
            <div class="col-12 d-flex">
                <Button @onclick="async () => await OnShowModalClick(context, false)">
                    <span class="oi oi-magnifying-glass" aria-hidden="true" title="Ver"></span>
                </Button>

                @if (authService.User.Permissions.Contains((long)SectionsEnum.Administrar))
                {
                   <Button @onclick="async () => await OnShowModalContractClick(context)"> 
                     <span class="oi oi-script" aria-hidden="true" title="Contratos"></span>
                   </Button>
                }

                @if (authService.User.Permissions.Contains((long)SectionsEnum.Administrar))
                {
                    <Button @onclick="async () => await OnShowCustomPermissionClick(context.Id)">
                        <span class="oi oi-shield" aria-hidden="true" title="Permisos"></span>
                    </Button>
                }

                <Button @onclick="async () => await OnShowModalClick(context)">
                    <span class="oi oi-pencil" aria-hidden="true" title="Editar"></span>
                </Button>

                <Button @onclick="async () => await SaveDelete(context.Id)">
                    <span class="oi oi-circle-x" aria-hidden="true" title="Eliminar" style="color: var(--l-red)"></span>
                </Button>
            </div>
        </div>
    </GridColumn>
</Grid>

