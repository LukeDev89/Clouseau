            <div class="col-12">
                <label class="form-label">Contrato</label>
                <InputSelect class="form-select" @bind-Value="editUserClientContract.ClientContractId">
                    @foreach (var p in _clientContracts)
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                </InputSelect>
            </div>
            <div class="col-12 pt-2">
                <label class="form-label">Horas</label>
                <InputNumber Class="form-control" Step="0.5" @bind-Value="editUserClientContract.Hours"></InputNumber>
            </div>
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <div class="row">
            <div class="col-6">
                <Button Class="btn btn-primary form-control" @onclick="SaveEditContract">Guardar</Button>
            </div>
            <div class="col-6">
                <Button Class="btn btn-secondary form-control" @onclick="OnHideEditContractModal">Cancelar</Button>
            </div>
        </div>
    </FooterTemplate>
</Modal>


<Modal @ref="modalCustomPermission" Title="Permisos Personalizados" Size="ModalSize.Large">
    <BodyTemplate>
        <div>
            <h5>Configurar permisos personalizados</h5>
            <div class="form-group">
                <label for="section">Seleccionar sección:</label>
                <div class="col-6">
                    <InputSelect class="form-select" @bind-Value="createCustomPermission.SectionId">
                        <option selected value="-1" disabled>Seleccione</option>
                        @foreach (var p in _sections.Where(s => !_customPermissions.Any(cp => cp.SectionId == s.Id)))
                        {
                            <option value="@p.Id">@p.Name</option>
                        }
                    </InputSelect>
                </div>
            </div>
        </div>

        <div class="row pt-4">
            <div class="col-6" style="margin-top: 20px">
                <h5>Secciones asignadas:</h5>
            </div>
        </div>

        <div class="row pt-2">
            <div class="col-12">
                @if (_filteredCustomPermissions != null && _filteredCustomPermissions.Any())
                {
                    @foreach (var p in _filteredCustomPermissions)
                    {
                        <div class="row pt-1">
                            <div class="col-8 d-flex align-items-center">
                                @p.Section.Name
                            </div>

                            <div class="col-2 d-flex align-items-center">
                                 <Button Class="btn form-control ms-2" Color="ButtonColor.Primary" @onclick="@(() => DeleteCustomPermission(p.Id))">
                                    <span class="oi oi-circle-x" aria-hidden="true" style="color: var(--l-white)"></span>
                                </Button> 
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="row">
                        <div class="col-12 d-flex align-items-center">
                            No se encontraron permisos personalizados.
                        </div>
                    </div>
                }
            </div>
        </div>

    </BodyTemplate>
    <FooterTemplate>
        <div class="col-3">
            <Button Class="btn btn-primary form-control" @onclick="SaveCustomPermission">Guardar</Button>
        </div>
        <div class="col-3">
            <Button Class="btn btn-secondary form-control" @onclick="OnHideCustomPermissionClick">Cerrar</Button>
        </div>
    </FooterTemplate>
</Modal>




@code {
    [Inject] ToastService ToastService { get; set; }
    private Collapse collapseAgregar;
    private Grid<User> grid;

    private Modal modal;
    private Modal modalUserContract;
    private Modal modalEditContract;
    private Modal modalCustomPermission;

    private User modalUser { get; set; } = new User() { RoleId = -1, ProfileId = -1, Province = "", Seniority = "", Superior = -1 };
    private User createUser { get; set; } = new User() { RoleId = -1, ProfileId = -1, Province = "", Seniority = "", Superior = -1 };

    private User userContract { get; set; } = new User();
    private ClientContract clientContract { get; set; } = new ClientContract();

    private UserClientContract userClientContract { get; set; } = new UserClientContract() { Hours = 160 };
    private UserClientContract editUserClientContract = new UserClientContract() { Hours = 160 };

    private CustomPermission selectedPermission = new CustomPermission();
    private CustomPermission createCustomPermission = new CustomPermission();


    private long currentUserId;
    private bool modalEdit = false;

    private List<User> _users = new List<User>();
    private List<User> _usersSuperiors = new List<User>();
    private List<Profile> _profiles = new List<Profile>();
    private List<Role> _roles = new List<Role>();
    private List<Team> _teams = new List<Team>();
    private List<Team> _userTeams = new List<Team>();
    private List<ClientContract> _clientContracts = new List<ClientContract>();

    private List<UserClientContract> _userClientContracts = new List<UserClientContract>();
    private List<UserClientContract> _filteredUserClientContracts = new List<UserClientContract>();


    private List<CustomPermission> _customPermissions = new List<CustomPermission>();
    private List<CustomPermission> _filteredCustomPermissions = new List<CustomPermission>();

    private List<Section> _sections = new List<Section>();
    private List<Section> _assignedSections = new List<Section>();

    protected override async Task OnInitializedAsync()
    {
        await GetGrid();
        await base.OnInitializedAsync();
    }

    protected override void OnInitialized()
    {
        userClientContract.ClientContractId = -1;
        createCustomPermission.SectionId = -1;

    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await GetCombo();
    }

    private async Task GetGrid()
    {
        try
        {
            _users = await _service.GetAsync();
        }
        catch (Exception ex)
        {
            ToastService.Notify(new ToastMessage()
                {
                    Type = ToastType.Danger,
                    Message = "Error inesperado al realizar la acción",
                    Title = "Error"
                });
        }
    }

    private async Task GetCombo()
    {
        try
        {
            _profiles = (await _profileService.GetAsync()).Where(x => x.Active).ToList();
            _roles = (await _roleService.GetAsync()).Where(x => x.Active).ToList();
            _teams = await _teamService.GetAsync();

            _clientContracts = await _contractService.GetAsync();
            _userClientContracts = (await _contractService.GetUserClientContractAsync()).Where(x => x.UserId == currentUserId).ToList();

            _usersSuperiors = _users.Where(u => u.Role.Hierarchy > 1).OrderBy(x => x.UserFullName).ToList();
            _teams = _teams.Where(x => x.Active).ToList();
            _sections = await _sectionService.GetAsync();

            _customPermissions = (await _sectionService.GetCustomPermissionAsync()).Where(x => x.UserId == currentUserId).ToList();

            foreach (var t in _teams)
            {
                t.Projects = t.Projects.Where(x => x.Active).ToList();
            }
        }
        catch (Exception ex)
        {
            ToastService.Notify(new ToastMessage()
                {
                    Type = ToastType.Danger,
                    Message = "Error inesperado al realizar la acción",
                    Title = "Error"
                });
        }
    }

    private async Task SaveAdd()
    {
        try
        {

            if (!string.IsNullOrEmpty(createUser.Username) && createUser.Username.Contains('@'))
            {
                createUser.Username = createUser.Username.Split('@')[0];
            }

            createUser.IsActive = true;

            await _service.AddAsync(createUser);

            await GetGrid();
            await grid.RefreshDataAsync();

            changedState.InitChanges();

            CancelAdd();

            ToastService.Notify(new ToastMessage()
                {
                    Type = ToastType.Success,
                    Message = $"Acción realizada con éxito.",
                    Title = "Crear Usuario"
                });
        }
        catch (Exception ex)
        {
            ToastService.Notify(new ToastMessage()
                {
                    Type = ToastType.Danger,
                    Message = "Error inesperado al realizar la acción",
                    Title = "Error"
                });
        }
    }

    private async Task AddContract()
    {
        userClientContract.UserId = currentUserId;

        try
        {
            await _contractService.AddUserClientContractAsync(userClientContract);

            _userClientContracts = (await _contractService.GetUserClientContractAsync()).Where(x => x.UserId == currentUserId).ToList();

            _filteredUserClientContracts = _userClientContracts;

            await grid.RefreshDataAsync();
            await GetGrid();


            changedState.InitChanges();

            ToastService.Notify(new ToastMessage()
                {
                    Type = ToastType.Success,
                    Message = $"Acción realizada con éxito.",
                    Title = "Crear Equipo"
                });
        }
        catch (Exception ex)
        {
            ToastService.Notify(new ToastMessage()
                {
                    Type = ToastType.Danger,
                    Message = "Error inesperado al realizar la acción",
                    Title = "Error"
                });
        }
    }

    private async Task SaveCustomPermission()
    {
        createCustomPermission.UserId = currentUserId;

        try
        {
            await _sectionService.AddCustomPermissionAsync(createCustomPermission);

            _customPermissions = (await _sectionService.GetCustomPermissionAsync()).Where(x => x.UserId == currentUserId).ToList();

            _filteredCustomPermissions = _customPermissions;

            await GetGrid();
            await grid.RefreshDataAsync();

            changedState.InitChanges();

            CancelAdd();

            ToastService.Notify(new ToastMessage()
                {
                    Type = ToastType.Success,
                    Message = $"Acción realizada con éxito.",
                    Title = "Asignar Permiso"
                });
        }
        catch (Exception ex)
        {
            ToastService.Notify(new ToastMessage()
                {
                    Type = ToastType.Danger,
                    Message = "Error inesperado al realizar la acción",
                    Title = "Error"
                });
        }
    }


    private void CancelAdd()
    {
        createUser = new User() { RoleId = -1, ProfileId = -1, Province = "", Seniority = "", Superior = -1 };
        createCustomPermission.Id = default;
    }

    private async Task DeleteContract(long contractId)
    {
        try
        {
            await _contractService.DeleteUserContractAsync(contractId);

            _filteredUserClientContracts = _filteredUserClientContracts.Where(x => x.ClientContractId != contractId).ToList();

            _userClientContracts = (await _contractService.GetUserClientContractAsync()).Where(x => x.UserId == currentUserId).ToList();

            _filteredUserClientContracts = _userClientContracts;

            await grid.RefreshDataAsync();
            await GetGrid();


            ToastService.Notify(new ToastMessage()
                {
                    Type = ToastType.Success,
                    Message = $"Contrato eliminado con éxito.",
                    Title = "Eliminar Contrato"
                });
        }
        catch (Exception ex)
        {
            ToastService.Notify(new ToastMessage()
                {
                    Type = ToastType.Danger,
                    Message = "Error inesperado al realizar la acción",
                    Title = "Error"
                });
        }
    }

    private async Task DeleteCustomPermission(long permissionId)
    {
        try
        {
            await _sectionService.DeleteCustomPermissionAsync(permissionId);

            _filteredCustomPermissions = _filteredCustomPermissions.Where(x => x.Id != permissionId).ToList();

            _customPermissions = (await _sectionService.GetCustomPermissionAsync()).Where(x => x.UserId == currentUserId).ToList();

            _filteredCustomPermissions= _customPermissions;

            await grid.RefreshDataAsync();
            await GetGrid();


            ToastService.Notify(new ToastMessage()
                {
                    Type = ToastType.Success,
                    Message = $"Contrato eliminado con éxito.",
                    Title = "Eliminar Contrato"
                });
        }
        catch (Exception ex)
        {
            ToastService.Notify(new ToastMessage()
                {
                    Type = ToastType.Danger,
                    Message = "Error inesperado al realizar la acción",
                    Title = "Error"
                });
        }
    }

    private async Task SaveEdit()
    {
        try
        {
            await _service.EditAsync(modalUser);

            await GetGrid();
            await grid.RefreshDataAsync();
            await OnHideModalClick();

            ToastService.Notify(new ToastMessage()
                {
                    Type = ToastType.Success,
                    Message = $"Acción realizada con éxito.",
                    Title = "Editar Usuario"
                });
        }
        catch (Exception ex)
        {
            ToastService.Notify(new ToastMessage()
                {
                    Type = ToastType.Danger,
                    Message = "Error inesperado al realizar la acción",
                    Title = "Error"
                });
        }
    }

    private async Task SaveEditContract()
    {
        try
        {

            await _contractService.EditContractAsync(editUserClientContract);

            _userClientContracts = (await _contractService.GetUserClientContractAsync()).Where(x => x.UserId == currentUserId).ToList();

            _filteredUserClientContracts = _userClientContracts;


            await grid.RefreshDataAsync();
            await OnHideEditContractModal();


            ToastService.Notify(new ToastMessage
                {
                    Type = ToastType.Success,
                    Message = $"Acción realizada con éxito.",
                    Title = "Editar Contrato"
                });
        }
        catch (Exception ex)
        {

            ToastService.Notify(new ToastMessage
                {
                    Type = ToastType.Danger,
                    Message = "Error inesperado al realizar la acción",
                    Title = "Error editar contrato"
                });
        }
    }

    private async Task SaveDelete(long Id)
    {
        try
        {
            await _service.DeleteAsync(Id);

            await GetGrid();
            await grid.RefreshDataAsync();
            await OnHideModalClick();

            ToastService.Notify(new ToastMessage()
                {
                    Type = ToastType.Success,
                    Message = $"Acción realizada con éxito.",
                    Title = "Eliminar Usuario"
                });
        }
        catch (Exception ex)
        {
            ToastService.Notify(new ToastMessage()
                {
                    Type = ToastType.Danger,
                    Message = "Error inesperado al realizar la acción",
                    Title = "Error"
                });
        }
    }

    private async Task OnShowModalClick(User user, bool editable = true)
    {
        modalUser = user;
        modalUser.Province = modalUser.Province != null ? modalUser.Province.Trim() : "";
        modalUser.Seniority = modalUser.Seniority != null ? modalUser.Seniority.Trim() : "";

        modalEdit = editable;

        _userTeams = _teams.Where(t => t.UserTeams.Any(ut => ut.UserId == modalUser.Id)).ToList();

        await modal?.ShowAsync();
    }

    private async Task OnShowModalContractClick(User user)
    {
        userContract = user;

        currentUserId = userContract.Id;

        _userClientContracts = (await _contractService.GetUserClientContractAsync()).Where(x => x.UserId == currentUserId).ToList();

        _filteredUserClientContracts = _userClientContracts;

        await modalUserContract.ShowAsync();
    }

    private async Task OnShowEditContractModal(UserClientContract userContract)
    {
        editUserClientContract = userContract;
       
        await modalEditContract.ShowAsync();
    }


    private async Task OnShowCustomPermissionClick(long userId)
    {
        currentUserId = userId; 

        _customPermissions = (await _sectionService.GetCustomPermissionAsync()).Where(x => x.UserId == currentUserId).ToList();

        _filteredCustomPermissions = _customPermissions;

        selectedPermission = new CustomPermission
            {
                UserId = userId,
                
            };

        await modalCustomPermission.ShowAsync();
    }


    private async Task OnHideModalClick()
    {
        modalUser = new User() { RoleId = -1, ProfileId = -1, Province = "", Seniority = "", Superior = -1 };

        await modal.HideAsync();
        await modalUserContract.HideAsync();
    }

    private Task OnHideEditContractModal()
    {
        return modalEditContract.HideAsync();
    }

    private async Task OnHideCustomPermissionClick()
    {
        await modalCustomPermission.HideAsync();
    }

    private async Task ToggleContentAsync() => await collapseAgregar.ToggleAsync();

    private void FilterUserClientContracts(long clientContractId)
    {
        _filteredUserClientContracts = _userClientContracts
            .Where(m => m.ClientContractId == clientContractId)
            .ToList();
        StateHasChanged();
    }

    private void FilterAssignedPermissions(long userId)
    {
        _filteredCustomPermissions = _customPermissions
            .Where(s => s.UserId == userId) 
            .ToList();

        StateHasChanged(); 
    }

}