<Modal @ref="modalUserContract" Title="Contratos" Size="ModalSize.Large">
    <BodyTemplate>
        <div class="row">
            <div class="col-12">
                <h4><b>@userContract.UserFullName</b></h4>
            </div>
        </div>

        <div class="row pt-2">
            <div class="col-6">
                <label class="form-label">Seleccionar Contrato</label>
            </div>

            <div class="col-6">
                <label class="form-label">Importar horas</label>
            </div>
        </div>

        <div class="row pt-1">
            <div class="col-6">
                <InputSelect class="form-select" @bind-Value="userClientContract.ClientContractId">
                    <option selected value=-1>Seleccione</option>
                    @foreach (var p in _clientContracts)
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                </InputSelect>
            </div>

            <div class="col-6">
                <InputNumber Class="form-control" Step="0.5" @bind-Value="userClientContract.Hours"></InputNumber>
            </div>
        </div>

        <div class="row pt-3">
            <div class="col-3 offset-9">
                <Button Class="btn btn-primary form-control" onclick="@(() => AddContract())">
                    Agregar
                </Button>
            </div>
        </div>

        <div class="row pt-4">
            <div class="col-6" style="margin-top: 20px">
                <h5>Contratos asignados de @userContract.UserFullName:</h5>
            </div>
            <div class="col-6" style="margin-top: 20px">
                <h5>Horas Importadas:</h5>
            </div>
        </div>

        <div class="row pt-2">
            <div class="col-12">
                @if (_filteredUserClientContracts.Count == 0)
                {
                    <div class="row">
                        <div class="col-12 d-flex align-items-center">
                            No hay contratos agregados
                        </div>
                    </div>
                }
                else if (_filteredUserClientContracts.Count > 0)
                    foreach (var u in _filteredUserClientContracts)
                    {
                        <div class="row pt-1">
                            <div class="col-8 d-flex align-items-center">
                                @u.ClientContract.Name
                            </div>

                            <div class="col-2 d-flex align-items-center">
                                @u.Hours
                            </div>

                            <div class="col-2 d-flex align-items-center">
                                <Button Class="btn form-control" Color="ButtonColor.Primary" @onclick="@(() => OnShowEditContractModal(u))">
                                    <span class="oi oi-pencil" aria-hidden="true" style="color: var(--l-white)"></span>
                                </Button>
                                <Button Class="btn form-control ms-2" Color="ButtonColor.Primary" @onclick="@(() => DeleteContract(u.Id))">
                                    <span class="oi oi-circle-x" aria-hidden="true" style="color: var(--l-white)"></span>
                                </Button>
                            </div>

                        </div>
                    }
            </div>
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <div class="col-3">
            <Button Class="btn form-control" Color="ButtonColor.Secondary" @onclick="OnHideModalClick">Cerrar</Button>
        </div>
    </FooterTemplate>
</Modal>


<Modal @ref="modalEditContract" Title="Editar Contrato" Size="ModalSize.Regular">
