@using BlazorBootstrap;
@using DataService.Auth;
@using DataService.State;
@using Website.Client.Pages.Management.InfoClients.AddClients;
@using Website.Client.Pages.Management.InfoClients.Contracts;
@using Website.Client.Pages.Management.InfoClients.Responsibles;

@inject AuthService _authService
@inject ChangedState changedState

@implements IDisposable
@inject ChangedState changedState

<BlazorBootstrap.Tabs EnableFadeEffect="true" OnShowing="@(args => OnTabShowingAsync(args))">

    @if (_authService.User.ProfileId == (long)DataModel.Enums.ProfileTypes.Administrador ||
    _authService.User.ProfileId == (long)DataModel.Enums.ProfileTypes.GestorProyectos)
    {
        <BlazorBootstrap.Tab Title="Clientes" IsActive="true">
            <Content>
                <Clients/> 
            </Content>
        </BlazorBootstrap.Tab>
    }

    <BlazorBootstrap.Tab Title="Contratos" IsActive="true">
        <Content>
            <Contracts /> 
        </Content>
    </BlazorBootstrap.Tab>

    <BlazorBootstrap.Tab Title="Responsables" IsActive="true">
        <Content>
            <Responsibles /> 
        </Content>
    </BlazorBootstrap.Tab>

</BlazorBootstrap.Tabs>

<div class="row tabRelleno" style="height:80px">
    <div class="col-12">

    </div>
</div> 

@code 
{
    protected override void OnInitialized()
    {
        changedState.ChangeAction += StateHasChanged;
    }

    public void Dispose()
    {
        changedState.ChangeAction -= StateHasChanged;
    }

    private void OnTabShowingAsync(TabsEventArgs args)
    {
        changedState.InitChanges();
    }
}