@page "/admin/inventory"

@using BlazorBootstrap;
@using DataService.Auth;
@using Website.Client.Pages.Management.Inventory

@inject AuthService authService
@inject NavigationManager navigationManager
@inject Blazored.LocalStorage.ILocalStorageService localStorage


<h3>Inventario</h3>

<TabManager />

@code {
    [Inject] protected PreloadService PreloadService { get; set; }
    [Inject] ToastService ToastService { get; set; }

    private bool _errorOccurred = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            PreloadService.Show();

            await base.OnInitializedAsync();
        }
        catch (Exception ex)
        {
            _errorOccurred = true;
        }
        finally
        {
            PreloadService.Hide();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (_errorOccurred)
            {
                await localStorage.ClearAsync();

                ToastService.Notify(new ToastMessage()
                    {
                        Type = ToastType.Danger,
                        Message = "Error inesperado al realizar la acción",
                        Title = "Error"
                    });

                navigationManager.NavigateTo("/");
            }
            else
            {
                if (!authService.IsLoggedIn)
                {
                    navigationManager.NavigateTo("/");
                }
                else
                {
                    var uri = navigationManager.Uri;
                    await localStorage.SetItemAsync("lastUrl", uri);
                    await localStorage.SetItemAsync("huboRecarga", false);
                }
            }
        }
    }
}
