@using BlazorBootstrap;
@using DataService.Auth;
@using DataService.State;
@using Website.Client.Pages.Management.Inventory.Software;
@using Website.Client.Pages.Management.Inventory.General;
@using Website.Client.Pages.Management.Inventory.AddBrand;
@using Website.Client.Pages.Management.Inventory.AddModel;
@using Website.Client.Pages.Management.Inventory.TechSupport;


@inject AuthService _authService
@inject ChangedState changedState

@implements IDisposable
@inject ChangedState changedState

<BlazorBootstrap.Tabs EnableFadeEffect="true" OnShowing="@(args => OnTabShowingAsync(args))">

    @if (_authService.User.ProfileId == (long)DataModel.Enums.ProfileTypes.Administrador ||
    _authService.User.ProfileId == (long)DataModel.Enums.ProfileTypes.GestorProyectos)
    {
        <BlazorBootstrap.Tab Title="General" IsActive="true">
            <Content>
                <Inventory/>
            </Content>
        </BlazorBootstrap.Tab>

        <BlazorBootstrap.Tab Title="Agregar Marcas">
            <Content>
                <AddBrand/>
            </Content>
        </BlazorBootstrap.Tab>

        <BlazorBootstrap.Tab Title="Agregar Modelos">
            <Content>
                <AddModel />
            </Content>
        </BlazorBootstrap.Tab>

        <BlazorBootstrap.Tab Title="Software">
            <Content>
                <InventoryLicense/>
            </Content>
        </BlazorBootstrap.Tab>

        <BlazorBootstrap.Tab Title="Servicio Tecnico">
            <Content>
                <InventoryPart />
            </Content>
        </BlazorBootstrap.Tab>
    }
</BlazorBootstrap.Tabs>

<div class="row tabRelleno" style="height:80px">
    <div class="col-12">

    </div>
</div> 

@code 
{
    protected override void OnInitialized()
    {
        changedState.ChangeAction += StateHasChanged;
    }

    public void Dispose()
    {
        changedState.ChangeAction -= StateHasChanged;
    }

    private void OnTabShowingAsync(TabsEventArgs args)
    {
        changedState.InitChanges();
    }
}