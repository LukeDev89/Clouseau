@page "/newpassword/{Username}/{Token}"

@using BlazorBootstrap;
@using DataContext
@using DataContext.Extension;
@using DataService.Auth
@using DataService.Interfaces.Management;

@inject IConfiguration Configuration
@inject NavigationManager Navigation
@inject IUserService userService
@inject AuthService authService

<br />
<EditForm Model="@loginModel" OnValidSubmit="@HandleLogin">

<div class="row d-flex justify-content-center">
    <div class="col-3">
        <Card>
            <CardBody>
                <br />
                <div class="row">
                    <div class="col-12 d-flex justify-content-center">
                        <h5>Recuperar Contraseña</h5>
                    </div>
                </div>
                <br />
                <br />
                <div class="row">
                    <div class="col-1"></div>
                    <div class="col-10">
                        <InputText placeholder="Nueva Contraseña" type="password" Class="form-control" @bind-Value="loginModel.Password"></InputText>
                    </div>
                </div>
                <br />
                <div class="row">
                    <div class="col-1"></div>
                    <div class="col-10">
                            <InputText placeholder="Repita Contraseña" type="password" Class="form-control" @bind-Value="loginModel.RePassword"></InputText>
                    </div>
                </div>
                <br />
                <br />
                <div class="row">
                    <div class="col-1"></div>
                    <div class="col-5">
                        <Button Class="btn btn-secondary form-control" @onclick="() => NavigateToIndex()">
                            Cancelar
                        </Button>
                    </div>
                    <div class="col-5">
                        <Button Class="btn btn-primary form-control" Type="ButtonType.Submit">
                            Enviar
                        </Button>
                    </div>
                </div>
                <br />
            </CardBody>
        </Card>
    </div>
</div>
</EditForm>
@code {
    private class LoginModel
    {
        public string Password { get; set; } = "";
        public string RePassword { get; set; } = "";
    }

    [Parameter] public string Username { get; set; } = "";
    [Parameter] public string Token { get; set; } = "";

    [Inject] ToastService ToastService { get; set; }

    private LoginModel loginModel = new LoginModel();

    private User? User { get; set; }

    private void NavigateToIndex() => Navigation.NavigateTo("/");

    protected override async Task OnInitializedAsync()
    {
        User = authService.IsLoggedIn ? authService.User : await userService.GetUserByUsername(Username);

        var validateToken = authService.IsLoggedIn ? false : PasswordHelper.HashPassword(Token) != User.Password;

        if (User == null || validateToken)
        {
            ToastService.Notify(new ToastMessage()
            {
                Type = ToastType.Danger,
                Message = "Error de Usuario o Token.",
                Title = "Error de Recuperación"
            });

            NavigateToIndex();
        }
    }

    private async Task HandleLogin()
    {
        if (loginModel.Password == "" || loginModel.RePassword == "")
        {
            ToastService.Notify(new ToastMessage()
            {
                Type = ToastType.Danger,
                Message = "Las contraseñas no pueden estar vacías.",
                Title = "Error de Cambio de Contraseña"
            });

            return;
        }

        if (loginModel.Password != loginModel.RePassword)
        {
            ToastService.Notify(new ToastMessage()
                {
                    Type = ToastType.Danger,
                    Message = "Las contraseñas no coinciden.",
                    Title = "Error de Cambio de Contraseña"
                });

            return;
        }
        else
        {
            var result = await userService.ChangePassword(User.Id, loginModel.Password);

            if (result)
            {
                Navigation.NavigateTo("/");
            }
            else
            {
                ToastService.Notify(new ToastMessage()
                {
                    Type = ToastType.Danger,
                    Message = "No se pudo cambiar la contraseña.",
                    Title = "Error de Cambio de Contraseña"
                });

                return;
            }
        }
    }
}
