<Grid TItem="FeedbackUser" @ref="grid"
Data="_feedBackUsers"
Class="table table-hover table-bordered table-striped"
AllowSorting="true"
AllowFiltering="true"
AllowPaging="true"
PageSize="20"
Responsive="true"
AllowDetailView="true">

    <GridColumns>
        <GridColumn TItem="FeedbackUser" HeaderText="Nombre" SortKeySelector="item => item.User.UserFullName" PropertyName="UserFullName" FilterOperator="FilterOperator.Contains">
            @context.User.UserFullName
        </GridColumn>

        <GridColumn TItem="FeedbackUser" HeaderText="Periodo" SortKeySelector="item => item.PeriodDateOnly" PropertyName="PeriodDateOnly" FilterOperator="FilterOperator.Equals">
            @context.PeriodDateOnly.ToString("MM/yyyy")
        </GridColumn>

        <GridColumn TItem="FeedbackUser" HeaderText="Activo" PropertyName="Active" Filterable="false" Sortable="false" FilterOperator="FilterOperator.Equals">
            @if (context.Active.HasValue && context.Active.Value)
            {
                <span class="oi oi-circle-check" aria-hidden="true" style="color: var(--l-green)"></span>
            }
            else
            {
                <span class="oi oi-circle-x" aria-hidden="true" style="color: var(--l-red)"></span>
            }
        </GridColumn>

        <GridColumn TItem="FeedbackUser" HeaderText="Acciones" Sortable="false" Filterable="false">
            <div class="d-inline-flex">
                @if (authService.User.ProfileId == (long)ProfileTypes.Administrador)
                {                   
                    <Button @onclick="async () => await OnShowModalPeriod(context)">
                        <span class="oi oi-clipboard" aria-hidden="true" title="Calificar"></span>
                    </Button>

                    <Button @onclick="async () => await OnShowModalImprovement(context, context.Id)">
                        <span class="oi oi-document" aria-hidden="true" title="Áreas De Mejora"></span>
                    </Button>

                    <Button @onclick="async () => await OnShowModalComment(context)">
                        <span class="oi oi-comment-square" aria-hidden="true" title="Comentarios"></span>
                    </Button>

                    <Button @onclick="async () => await ToggleActiveAsync(context)">
                        @if (context != null && context.Active.HasValue)
                        {
                            @if (context.Active.Value)
                            {
                                <span class="oi oi-circle-x" style="color: var(--l-red)" aria-hidden="true" title="Inhabilitar"></span>
                            }
                            else
                            {
                                <span class="oi oi-circle-check" style="color: var(--l-green)" aria-hidden="true" title="Habilitar"></span>
                            }
                        }
                    </Button>

                    <Button @onclick="async () => await SaveDefinitiveDeleteUser(context.Id)">
                        <span class="oi oi-trash" aria-hidden="true" title="Eliminar"></span>
                    </Button>
                }
                else if (authService.User.ProfileId != (long)ProfileTypes.Estandar && context.User.UserFullName != authService.User.UserFullName)
                {                  
                    <Button @onclick="async () => await OnShowModalPeriod(context)">
                        <span class="oi oi-clipboard" aria-hidden="true" title="Calificar"></span>
                    </Button>

                    <Button @onclick="async () => await OnShowModalImprovement(context, context.Id)">
                        <span class="oi oi-document" aria-hidden="true" title="Áreas De Mejora"></span>
                    </Button>

                    <Button @onclick="async () => await ToggleActiveAsync(context)">
                        @if (context != null && context.Active.HasValue)
                        {
                            @if (context.Active.Value)
                            {
                                <span class="oi oi-circle-x" style="color: var(--l-red)" aria-hidden="true" title="Inhabilitar"></span>
                            }
                            else
                            {
                                <span class="oi oi-circle-check" style="color: var(--l-green)" aria-hidden="true" title="Habilitar"></span>
                            }
                        }
                    </Button>

                    <Button @onclick="async () => await SaveDefinitiveDeleteUser(context.Id)">
                        <span class="oi oi-trash" aria-hidden="true" title="Eliminar"></span>
                    </Button>
                }
                else
                {
                    <Button @onclick="async () => await OnShowModalComment(context)">
                        <span class="oi oi-comment-square" aria-hidden="true" title="Comentarios"></span>
                    </Button>
                }
            </div>
        </GridColumn>
    </GridColumns>

    <GridDetailView TItem="FeedbackUser">
        <div class="row">
            <div class="col-12">
                @{
                    var groupedFeedbackItems = _feedBackItems
                    .GroupBy(item => item.FeedbackStandar.Name)
                    .ToList();

                    foreach (var group in groupedFeedbackItems)
                    {
                        <div class="row">
                            <div class="col-8" style="margin-bottom: 10px">
                                <span><b>@group.Key</b></span>
                            </div>
                            <div class="col-2">
                                <span class="oi oi-question-mark" aria-hidden="true" title="@(group.ToList().Count > 0 ? group.ToList()[0].FeedbackStandar.Description : "")"></span>
                            </div>
                        </div>

                        foreach (var item in group)
                        {
                            var feedbackPeriod = context.FeedbackPeriods.FirstOrDefault(x => x.FeedbackItemId == item.Id);

                            <div class="row">
                                <div class="col-6">
                                    <span>@item.Name</span>
                                </div>
                                <div class="col-2">
                                    <span>@(feedbackPeriod == null || feedbackPeriod.FeedbackStandarType == null ? "N/A" : feedbackPeriod.FeedbackStandarType.Name)</span>
                                </div>
                                <div class="col-2">
                                    <span class="oi oi-info" aria-hidden="true" title="@(feedbackPeriod == null || feedbackPeriod.FeedbackStandarType == null ? "N/A" : feedbackPeriod.FeedbackStandarType.Description)"></span>
                                </div>
                            </div>
                        }

                        <div class="row">
                            <div class="col-12">
                                <hr />
                            </div>
                        </div>
                    }

                    if (context.FeedbackImprovementUsers.Count > 0)
                    {
                        <div class="row">
                            <div class="col-12" style="margin-top: 20px; margin-bottom: 10px">
                                <h5>Áreas de Mejora</h5>
                            </div>
                        </div>

                        @foreach (var i in context.FeedbackImprovementUsers)
                        {
                            <div class="row">
                                <div class="col-8">
                                    <span><b>@i.FeedbackImprovement.Name</b></span>
                                </div>
                                <div class="col-2">
                                    <span class="oi oi-question-mark" aria-hidden="true" title="@i.FeedbackImprovement.Description"></span>
                                </div>
                            </div>
                            <div class="row" style="margin-bottom: 10px">
                                <div class="col-12">
                                    <span>@i.Description</span>
                                </div>
                            </div>
                        }
                    }

                }
            </div>
        </div>
    </GridDetailView>
</Grid>


<Modal @ref="modalPeriod" Title="Calificar Periodo" Size="ModalSize.ExtraLarge">
    <BodyTemplate>
        <div class="container">

            <div class="row">
                <div class="col-12">
                    <h6 style="text-align: center;"><b>Feedback de @editFeedbackuser.User.Firstname @editFeedbackuser.User.Lastname</b></h6>
                    <div style="display: none">
                        @editFeedbackuser.Id
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-12">
                    <Grid TItem="FeedbackPeriod" @ref="gridPeriod"
                    Data="editFeedbackuser.FeedbackPeriods"
                    Class="table table-hover table-bordered table-striped"
                    Responsive="true">

                        <GridColumn TItem="FeedbackPeriod" HeaderText="Categoría">
                            @context.FeedbackItem?.FeedbackStandar?.Name
                        </GridColumn>

                        <GridColumn TItem="FeedbackPeriod" HeaderText="Evaluación">
                            @context.FeedbackItem.Name
                        </GridColumn>

                        <GridColumn TItem="FeedbackPeriod" HeaderText="Valoración">
                            <ChildContent>
                                <InputSelect ValueExpression="@(() => context.FeedbackStandarTypeId)" Value="context.FeedbackStandarTypeId" ValueChanged="@(async (long? value) => await OnStandarTypeSelected(context, value))">
                                    <option value="">Seleccione</option>
                                    @foreach (var type in _feedBackStandarTypes.Where(t => t.FeedbackStandarId == context.FeedbackItem.FeedbackStandarId))
                                    {
                                        <option value="@type.Id">@type.Name</option>
                                    }
                                </InputSelect>
                            </ChildContent>
                        </GridColumn>

                        <GridColumn TItem="FeedbackPeriod" HeaderText="Criterio">
                            @if (context.FeedbackStandarType != null)
                            {
                                @context.FeedbackStandarType.Description
                            }
                            else
                            {
                                <span>N/A</span>
                            }
                        </GridColumn>
                    </Grid>
                </div>
            </div>
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <div class="row col-12">
            <div class="col-9">
            </div>
            <div class="col-3">
                <Button Class="btn form-control" Color="ButtonColor.Secondary" @onclick="OnHideModalPeriod">Cerrar</Button>
            </div>
        </div>
    </FooterTemplate>
</Modal>

