@using BlazorBootstrap
@using DataContext
@using DataModel.Enums
@using DataService.Auth;
@using DataService.Interfaces.Management;
@using DataService.Interfaces.ProjectManagement
@using DataService.State;

@inherits Period

@inject IFeedBackUserService _feedBackUserService
@inject IFeedBackPeriodService _feedBackPeriodService
@inject IFeedBackItemService _feedBackItemService
@inject IFeedBackCommentService _feedBackCommentService
@inject IFeedBackStandarTypeService _feedBackStandarTypeService
@inject IFeedBackImprovementService _feedBackImprovementService
@inject IFeedBackImprovementUserService _feedBackImprovementUserService
@inject IFeedBackStandarService _feedBackStandarService

@inject IJSRuntime JSRuntime
@inject IUserService _userService
@inject AuthService authService

@inject ChangedState changedState

@if (authService.User.ProfileId != (long)ProfileTypes.Estandar)
{
    <br />

    <div class="row">
        <div class="col-12">
            <Button Class="form-control" Type="ButtonType.Button" Color="ButtonColor.Primary" @onclick="ToggleContentAsync">
                Crear Feedback de Recurso
            </Button>
        </div>
    </div>

    <Collapse @ref="collapseAddFeedBackUser">
        <Card>
            <CardBody>
                <div class="row">
                    <div class="col-3">
                        <span class="text-nowrap">Usuario</span>
                    </div>
                    <div class="col-3">
                        <span class="text-nowrap">Periodo</span>
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-3">
                        <InputSelect id="userSelect" class="form-select" @bind-Value="createFeedbackuser.UserId">
                            <option value="-1" disabled="@(createFeedbackuser.UserId != -1)">Seleccione</option>
                            @foreach (var p in _users.Where(u => u.IsActive).OrderBy(u => u.UserFullName))
                            {
                                <option value="@p.Id">@p.UserFullName</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-3">
                        <DateInput Class="form-control" @bind-Value="@createFeedbackuser.Period"></DateInput>
                    </div>
                    <div class="col-3 d-flex justify-content-center align-items-end">
                        <Button Class="btn btn-secondary form-control" onclick="@(() => CancelAdd())">
                            Limpiar
                        </Button>
                    </div>
                    <div class="col-3 d-flex justify-content-center align-items-end">
                        <Button Class="btn btn-primary form-control" onclick="@(() => SaveAdd())">
                            Crear
                        </Button>
                    </div>
                </div>
            </CardBody>
        </Card>
    </Collapse>
}

