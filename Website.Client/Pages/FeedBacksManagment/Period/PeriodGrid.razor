@code {
    [Inject] private ToastService ToastService { get; set; }
    [Inject] protected PreloadService PreloadService { get; set; }

    private Collapse collapseAddImprovementUser;

    private Grid<FeedBackUser> grid;
    private Grid<FeedBackPeriod> gridPeriod;
    private Grid<FeedBackImprovementUser> gridImprovementUser;

    private FeedBackUser editFeedbackuser { get; set; } = new FeedBackUser();
    private FeedBackUser createFeedbackuser { get; set; } = new FeedBackUser();

    private FeedBackPeriod createFeedbackPeriod { get; set; } = new FeedBackPeriod();

    private FeedBackImprovement editFeedbackImprovement { get; set; } = new FeedBackImprovement();
    private FeedBackImprovement createFeedbackImprovement { get; set; } = new FeedBackImprovement();

    private FeedBackImprovementUser editFeedbackImprovementUsers { get; set; } = new FeedBackImprovementUser();
    private FeedBackImprovementUser createFeedbackImprovementUsers { get; set; } = new FeedBackImprovementUser();

    private FeedBackComment createFeedbackComments { get; set; } = new FeedBackComment();

    private List<FeedBackUser> _feedBackUsers = new List<FeedBackUser>();

    private List<User> _users = new List<User>();
    private List<FeedBackItem> _feedBackItems = new List<FeedBackItem>();
    private List<FeedBackStandarType> _feedBackStandarTypes = new List<FeedBackStandarType>();
    private List<FeedBackImprovement> _feedBackImprovements = new List<FeedBackImprovement>();
    private List<FeedBackImprovementUser> _feedBackImprovementUsers = new List<FeedBackImprovementUser>();

    private long currentUserId;
    private FeedBackUser selectedFeedBackUser = new FeedBackUser();

    protected override async Task OnInitializedAsync()
    {
        createFeedbackuser.UserId = -1;
        editFeedbackImprovementUsers.Description = null;
        createFeedbackImprovement.Id = -1;

        if (createFeedbackuser.Period == default)
        {
            createFeedbackuser.Period = DateTime.Today;
        }

        changedState.ChangeAction += StateHasChanged;

        try
        {
            PreloadService.Show();

            await GetGrid();
            await GetCombo();
        }
        catch (Exception e)
        {
            ToastService.Notify(new ToastMessage()
                {
                    Type = ToastType.Danger,
                    Message = "Error inesperado al realizar la acción.",
                    Title = "Error"
                });
        }
        finally
        {
            PreloadService.Hide();
        }

        await base.OnInitializedAsync();
    }

    public void Dispose()
    {
        changedState.ChangeAction -= StateHasChanged;
    }

    private async Task GetGrid()
    {
        _feedBackUsers = await _feedBackUserService.GetByUserIdAsync(authService.User.Id);
        _feedBackImprovementUsers = (await _feedBackImprovementUserService.GetAsync()).Where(x => x.FeedbackUserId == currentUserId).ToList();

        if (authService.User.ProfileId == (long)ProfileTypes.Estandar)
        {
            _feedBackUsers = _feedBackUsers.Where(x => x.Active.HasValue && x.Active.Value).ToList();
        }
    }

    private async Task GetCombo()
    {
        if (authService.User.ProfileId == (long)ProfileTypes.Estandar)
        {
            _users = default!;
        }
        else if (authService.User.ProfileId == (long)ProfileTypes.GestorProyectos)
        {
            _users = await GetFilteredUsers(authService.User.Id);
        }
        else
        {
            _users = (await _userService.GetAsync()).Where(x => x.IsActive).ToList();
        }

        _feedBackItems = (await _feedBackItemService.GetAsync()).Where(x => x.Active == true).ToList();
        _feedBackStandarTypes = (await _feedBackStandarTypeService.GetAsync()).Where(x => x.Active == true).ToList();
        _feedBackImprovements = await _feedBackImprovementService.GetAsync();
    }

    private async Task<List<User>> GetFilteredUsers(long loggedInUserId) 
    {
        var allUsers = await _userService.GetAsync();

        var directSubordinates = allUsers
            .Where(x => x.Superior == loggedInUserId && x.IsActive && x.ProfileId != (long)ProfileTypes.GestorProyectos && x.ProfileId != (long)ProfileTypes.Administrador)
            .ToList();

        var loggedInUserTeams = allUsers
            .FirstOrDefault(x => x.Id == loggedInUserId)?
            .UserTeams
            .Select(ut => ut.TeamId)
            .Where(teamId => teamId != 2)
            .ToList();

        var teamMembers = allUsers
            .Where(x => x.UserTeams.Any(ut => loggedInUserTeams.Contains(ut.TeamId)) && x.IsActive
                        && x.ProfileId != (long)ProfileTypes.GestorProyectos && x.ProfileId != (long)ProfileTypes.Administrador)
            .ToList();

        return directSubordinates.Union(teamMembers).Distinct().ToList();
    }


    private async Task SaveAdd()
    {
        await SaveAddFeedBackUser();
        await SaveAddPeriod();
    }

    private void CancelAdd()
    {
        createFeedbackuser.Period = DateTime.Now;
        createFeedbackuser.User = null!;
        createFeedbackComments.Comment = null!;
        createFeedbackImprovementUsers = new FeedBackImprovementUser();
        createFeedbackImprovement.Id = -1;
    }

    private async Task SaveAddFeedBackUser()
    {
        try
        {
            await _feedBackUserService.AddAsync(createFeedbackuser);

            await GetGrid();

            changedState.InitChanges();

            CancelAdd();

            ToastService.Notify(new ToastMessage()
                {
                    Type = ToastType.Success,
                    Message = "Acción realizada con exito",
                    Title = "Agregar FeedBackUser"
                });
        }
        catch (Exception ex)
        {
            ToastService.Notify(new ToastMessage()
                {
                    Type = ToastType.Danger,
                    Message = "Error inesperado al realizar la acción: FB user",
                    Title = "Error"
                });
        }
    }

    private async Task SaveAddPeriod()
    {
        try
        {
            createFeedbackPeriod.FeedbackUserId = createFeedbackuser.Id;
            var feedbackItemIds = _feedBackItems.Select(item => item.Id).ToList();

            foreach (var feedbackItemId in feedbackItemIds)
            {
                var newFeedbackPeriod = new FeedBackPeriod
                    {
                        FeedbackUserId = createFeedbackPeriod.FeedbackUserId,
                        FeedbackStandarTypeId = null,
                        FeedbackItemId = feedbackItemId
                    };

                await _feedBackPeriodService.AddAsync(newFeedbackPeriod);
            }

            createFeedbackPeriod = new FeedBackPeriod();
            createFeedbackuser = new FeedBackUser();

            await GetGrid();

            changedState.InitChanges();
            CancelAdd();

            ToastService.Notify(new ToastMessage()
                {
                    Type = ToastType.Success,
