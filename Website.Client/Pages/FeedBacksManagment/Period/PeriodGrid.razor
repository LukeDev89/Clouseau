    private async Task ToggleActiveAsync(FeedbackUser feedbackUser)
    {
        if (feedbackUser == null) return;

        feedbackUser.Active = !(feedbackUser.Active.HasValue && feedbackUser.Active.Value);

        try
        {
            await _feedBackUserService.EditAsync(feedbackUser);

            var action = feedbackUser.Active.Value ? "Activo" : "Inactivo";
            ToastService.Notify(new ToastMessage
                {
                    Type = ToastType.Success,
                    Message = $"El periodo se encuentra {action}.",
                    Title = "Estado Actualizado"
                });

            StateHasChanged();

            await GetGrid();
        }
        catch (Exception ex)
        {
            ToastService.Notify(new ToastMessage
                {
                    Type = ToastType.Danger,
                    Message = "Error inesperado al realizar la acción",
                    Title = "Error"
                });
        }
    }

