@using BlazorBootstrap
@using DataContext
@using DataModel.Enums
@using DataService.Auth;
@using DataService.Interfaces.Management;
@using DataService.Interfaces.ProjectManagement
@using DataService.State;

@inherits Improvement

@inject IFeedBackImprovementService _improvementService
@inject ChangedState changedState

<br />

<div class="row">
    <div class="col-12">
        <Button Class="form-control" Type="ButtonType.Button" Color="ButtonColor.Primary" @onclick="ToggleContentAsync">
            Crear Área de Mejora
        </Button>
    </div>
</div>
<Collapse @ref="collapseAgregar">
    <Card>
        <CardBody>
            <div class="row">
                <div class="col-12">
                    <span class="text-nowrap">Nombre</span>
                </div>
                <div class="col-12">
                    <InputText class="form-control" @bind-Value="@createImprovement.Name" rows="1"></InputText>
                </div>
            </div>

            <div class="row mt-2">
                <div class="col-12">
                    <span class="text-nowrap">Descripción</span>
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-12">
                    <textarea class="form-control" @bind="createImprovement.Description" rows="3"></textarea>
                </div>
            </div>
            <div class="row mt-4">
                <div class="col-6">
                </div>
                <div class="col-6">
                    <div class="row">
                        <div class="col-6"></div>
                        <div class="col-3">
                            <Button Class="btn btn-secondary form-control" onclick="@(() => CancelAdd())">
                                Limpiar
                            </Button>
                        </div>
                        <div class="col-3">
                            <Button Class="btn btn-primary form-control" onclick="@(() => SaveAdd())">
                                Crear
                            </Button>
                        </div>
                    </div>

                </div>
            </div>
        </CardBody>
    </Card>

</Collapse>

<br />
<br />

<Grid TItem="FeedbackImprovement" @ref="grid"
      Data="_improvements"
      Class="table table-hover table-bordered table-striped"
      AllowSorting="true"
      AllowFiltering="true"
      AllowPaging="true"
      PageSize="8"
      Responsive="true">

    <GridColumn TItem="FeedbackImprovement" HeaderText="Área de Mejora" SortKeySelector="item => item.Name" PropertyName="Name" FilterOperator="FilterOperator.Contains">
        @context.Name
    </GridColumn>

    <GridColumn TItem="FeedbackImprovement" HeaderText="Descripción" SortKeySelector="item => item.Description" PropertyName="Description" FilterOperator="FilterOperator.Contains">
        @context.Description
    </GridColumn>

    <GridColumn TItem="FeedbackImprovement" HeaderText="Activo" Sortable="false" Filterable="false">
        <div style="text-align: center;">
            @if (context.Active.HasValue && context.Active.Value)
            {
                <span class="oi oi-circle-check" aria-hidden="true" style="color: var(--l-green)"></span>
            }
            else
            {
                <span class="oi oi-circle-x" aria-hidden="true" style="color: var(--l-red)"></span>
            }
        </div>
    </GridColumn>

    <GridColumn TItem="FeedbackImprovement" HeaderText="Acciones" Sortable="false" Filterable="false">
        <div class="text-center">
            <div class="d-inline-flex">
                <Button @onclick="async () => await OnShowModalClick(context)">
                    <span class="oi oi-pencil" aria-hidden="true" title="Editar"></span>
                </Button>

                <Button @onclick="async () => await ToggleActiveAsync(context)">
                    @if (context != null && context.Active.HasValue)
                    {
                        if (context.Active.Value)
                        {
                            <span class="oi oi-circle-x" style="color: var(--l-red)" aria-hidden="true" title="Inhabilitar"></span>
                        }
                        else
                        {
                            <span class="oi oi-circle-check" style="color: var(--l-green)" aria-hidden="true" title="Habilitar"></span>
                        }
                    }
                </Button>

                <Button @onclick="async () => await SaveDefinitiveDelete(context.Id)">
                    <span class="oi oi-trash" aria-hidden="true" title="Eliminar"></span>
                </Button>
            </div>
        </div>
    </GridColumn>

</Grid>


<Modal @ref="modal" Title="Editar CECO" Size="ModalSize.Large">

    <BodyTemplate>
        <div class="row">
            <div class="col-12">
                <h5><b>@editImprovement.Name</b></h5>
                <div style="display: none">
                    @editImprovement.Id
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-2 mt-2">
                Nombre
            </div>
            <div class="col-10">
                <InputText Class="form-control" @bind-Value="@editImprovement.Name"></InputText>
            </div>

        </div>

        <div class="row mt-2">
            <div class="col-2 mt-4">
                Descripción
            </div>
            <div class="col-10">
                <textarea class="form-control" @bind="editImprovement.Description" rows="4"></textarea>
            </div>
        </div>

    </BodyTemplate>
    <FooterTemplate>
        <div class="col-3">
            <Button Class="btn form-control" Color="ButtonColor.Secondary" @onclick="OnHideModalClick">Cerrar</Button>
        </div>
        <div class="col-3">
            <Button Class="btn form-control" Color="ButtonColor.Primary" @onclick="SaveEdit">Guardar</Button>
        </div>
    </FooterTemplate>
</Modal>

@code {
    [Inject] private ToastService ToastService { get; set; }
    [Inject] private PreloadService PreloadService { get; set; }

    private Collapse collapseAgregar;
    private Grid<FeedBackImprovement> grid;

    private Modal modal;
    private FeedBackImprovement editImprovement { get; set; } = new FeedBackImprovement();
    private FeedBackImprovement createImprovement { get; set; } = new FeedBackImprovement();
    private List<FeedBackImprovement> _improvements = new List<FeedBackImprovement>();

    protected override async Task OnInitializedAsync()
    {
        changedState.ChangeAction += StateHasChanged;

        try
        {
            PreloadService.Show();

            await GetGrid();
        }
        catch (Exception e)
        {
            ToastService.Notify(new ToastMessage()
                {
                    Type = ToastType.Danger,
                    Message = "Error inesperado al realizar la acción",
                    Title = "Error"
                });
        }
        finally
        {
            PreloadService.Hide();
        }

        await base.OnInitializedAsync();
    }

    public void Dispose()
    {
        changedState.ChangeAction -= StateHasChanged;
    }

    private async Task GetGrid()
    {
            _improvements = await _improvementService.GetAsync();
    }

    private async Task SaveAdd()
    {
        try
        {
            await _improvementService.AddAsync(createImprovement);

            await GetGrid();
            await grid.RefreshDataAsync();

            changedState.InitChanges();

            CancelAdd();

            ToastService.Notify(new ToastMessage()
                {
                    Type = ToastType.Success,
                    Message = "Acción realizada con exito",
                    Title = "Agregar Área de Mejora"
                });
        }
        catch (Exception ex)
        {
            ToastService.Notify(new ToastMessage()
                {
                    Type = ToastType.Danger,
                    Message = "Error inesperado al realizar la acción",
                    Title = "Error"
                });
        }
    }

    private void CancelAdd()
    {
        createImprovement = new FeedBackImprovement();
    }

    private async Task SaveEdit()
    {
        try
        {
            await _improvementService.EditAsync(editImprovement);

            await GetGrid();
            await grid.RefreshDataAsync();
            await OnHideModalClick();

            ToastService.Notify(new ToastMessage()
                {
                    Type = ToastType.Success,
                    Message = "Acción realizada con exito",
                    Title = "Editar Área de Mejora"
                });
        }
        catch (Exception ex)
        {
            ToastService.Notify(new ToastMessage()
                {
                    Type = ToastType.Danger,
                    Message = "Error inesperado al realizar la acción",
                    Title = "Error"
                });
        }
    }

    private async Task SaveDelete(long Id)
    {
        try
        {
            await _improvementService.DeleteAsync(Id);

            await GetGrid();
            await grid.RefreshDataAsync();
            await OnHideModalClick();

            ToastService.Notify(new ToastMessage()
                {
                    Type = ToastType.Success,
                    Message = "Acción realizada con exito",
                    Title = "Eliminar Área de Mejora"
                });
        }
        catch (Exception ex)
        {
            ToastService.Notify(new ToastMessage()
                {
                    Type = ToastType.Danger,
                    Message = "Error inesperado al realizar la acción",
                    Title = "Error"
                });
        }
    }


    private async Task OnShowModalClick(FeedBackImprovement improvement)
    {
        editImprovement = improvement;

        await modal?.ShowAsync();
    }

    private async Task OnHideModalClick()
    {
        editImprovement.Active = default;
        await modal?.HideAsync();
    }

    private async Task ToggleContentAsync() => await collapseAgregar.ToggleAsync();

    private async Task ToggleActiveAsync(FeedBackImprovement feedbackImprovement)
    {
        if (feedbackImprovement == null) return;

        feedbackImprovement.Active = !(feedbackImprovement.Active.HasValue && feedbackImprovement.Active.Value);

        try
        {
            await _improvementService.EditAsync(feedbackImprovement);

            var action = feedbackImprovement.Active.Value ? "Activo" : "Inactivo";
            ToastService.Notify(new ToastMessage
                {
                    Type = ToastType.Success,
                    Message = $"El periodo se encuentra {action}.",
                    Title = "Estado Actualizado"
                });

            StateHasChanged();

            await UpdateFeedbackUser();
        }
        catch (Exception ex)
        {
            ToastService.Notify(new ToastMessage
                {
                    Type = ToastType.Danger,
                    Message = "Error inesperado al realizar la acción",
                    Title = "Error"
                });
        }
    }

    private async Task UpdateFeedbackUser()
    {
        _improvements = await _improvementService.GetAsync();
    }

    private async Task SaveDefinitiveDelete(long Id)
    {
        try
        {


            await _improvementService.DefinitiveDeleteAsync(Id);

            await GetGrid();
            await grid.RefreshDataAsync();
            await OnHideModalClick();

            ToastService.Notify(new ToastMessage()
                {
                    Type = ToastType.Success,
                    Message = $"Acción realizada con éxito.",
                    Title = "Eliminar Área de Mejora "
                });
        }
        catch (Exception ex)
        {
            ToastService.Notify(new ToastMessage()
                {
                    Type = ToastType.Danger,
                    Message = "Error inesperado al realizar la acción",
                    Title = "Error"
                });
        }
    }
}